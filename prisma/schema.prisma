}

enum CaregiverInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

enum CaregiverAppointmentGrantStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum CaregiverRelationshipStatus {
  ACTIVE
  REVOKED
  WITHDRAWN
}

enum UserTakeoverProviderState {
  PENDING
  CONFIRMED
  RECONCILIATION_REQUIRED
  RESOLVED
}

model Person {
  id              String   @id @default(uuid()) @db.Uuid
  identityKeyHash String   @unique @db.VarChar(64)
  givenName       String?  @db.VarChar(120)
  familyName      String?  @db.VarChar(120)
  // Customer decision E3 (ก-19): optimistic-concurrency version for name correction.
  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User?
  patientProfile PatientProfile?
  patientAccessRequestsResolved PatientAccessRequest[] @relation("PatientAccessRequestResolvedPerson")

  @@index([familyName, givenName])
}

model User {
  serviceAreasCreated HospitalServiceArea[] @relation("ServiceAreaCreator")
  serviceAreasEnded HospitalServiceArea[] @relation("ServiceAreaEnder")
  networkRolesClassified HospitalServiceAreaEligibility[] @relation("NetworkRoleClassifier")
  hospitalsRetired Hospital[] @relation("HospitalRetiredBy")
  hospitalsRegistered Hospital[] @relation("HospitalRegisteredBy")
  hospitalRetirementEvents HospitalRetirementEvent[] @relation("HospitalRetirementActor")
  childOwnerInvitationsIssued HospitalMembership[] @relation("HospitalMembershipInvitedBy")
  id          String     @id @default(uuid()) @db.Uuid
  personId    String     @unique @db.Uuid
  authSubject String?    @unique @db.VarChar(255)
  providerLoginAlias String? @unique @db.VarChar(255)
  status      UserStatus @default(PROVISIONED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  person      Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  roles       UserRole[]
  memberships HospitalMembership[]
  reportExportGrantsIssued HospitalMembership[] @relation("HospitalMembershipReportExportGrantedBy")
  networkPatientReadGrantsIssued HospitalMembership[] @relation("HospitalMembershipNetworkPatientReadGrantedBy")
  patientSelfMeasurementsDeleted PatientSelfMeasurement[] @relation("PatientSelfMeasurementDeletedBy")
  osmHospitalRelationships OsmHospitalRelationship[] @relation("OsmHospitalRelationships")
  workforceActivations WorkforceActivation[] @relation("WorkforceActivationTarget")
  workforceActivationsCreated WorkforceActivation[] @relation("WorkforceActivationCreator")
  workforceBulkSubmissions WorkforceBulkSubmission[]
  patientActivations PatientActivation[] @relation("PatientActivationTarget")
  patientActivationsCreated PatientActivation[] @relation("PatientActivationCreator")
  accountRecoveries AccountRecovery[] @relation("AccountRecoveryTarget")
  accountRecoveriesIssued AccountRecovery[] @relation("AccountRecoveryIssuer")
  caregiverInvitationsReceived CaregiverInvitation[] @relation("CaregiverInvitationCaregiver")
  caregiverInvitationsIssued CaregiverInvitation[] @relation("CaregiverInvitationIssuer")
  caregiverInvitationsRevoked CaregiverInvitation[] @relation("CaregiverInvitationRevoker")
  caregiverRelationships CaregiverRelationship[] @relation("CaregiverRelationshipCaregiver")
  caregiverRelationshipsRevoked CaregiverRelationship[] @relation("CaregiverRelationshipRevoker")
  appointmentGrants CaregiverAppointmentGrant[] @relation("AppointmentGrantCaregiver")
  appointmentGrantsProposed CaregiverAppointmentGrant[] @relation("AppointmentGrantProposer")
  appointmentGrantsAccepted CaregiverAppointmentGrant[] @relation("AppointmentGrantAccepter")
  appointmentGrantsRevoked CaregiverAppointmentGrant[] @relation("AppointmentGrantRevoker")
  patientOsmAssignments PatientOsmAssignment[] @relation("PatientOsmAssignments")
  patientOsmAssignmentsCreated PatientOsmAssignment[] @relation("PatientOsmAssignmentsCreated")
  patientOsmAssignmentsEnded PatientOsmAssignment[] @relation("PatientOsmAssignmentsEnded")
  patientHospitalRelationshipsEnded PatientHospitalRelationship[] @relation("PatientHospitalRelationshipsEnded")
  screeningAssessmentsConducted ScreeningAssessment[] @relation("ScreeningAssessmentConductedBy")
  goalPlansCreated PatientGoalPlan[] @relation("PatientGoalPlanCreatedBy")
  appointmentsResponsible PatientAppointment[] @relation("PatientAppointmentResponsible")
  appointmentsCreated PatientAppointment[] @relation("PatientAppointmentCreatedBy")
  appointmentAcknowledgementsRecorded PatientAppointmentAcknowledgement[] @relation("AppointmentAcknowledgementRecordedBy")
  appointmentCancellationRequestsSubmitted PatientAppointmentCancellationRequest[] @relation("AppointmentCancellationRequestSubmittedBy")
  appointmentRescheduleRequestsSubmitted PatientAppointmentRescheduleRequest[] @relation("AppointmentRescheduleRequestSubmittedBy")
  appointmentCancellationRequestsResolved PatientAppointmentCancellationRequest[] @relation("AppointmentCancellationRequestResolvedBy")
  appointmentRescheduleRequestsResolved PatientAppointmentRescheduleRequest[] @relation("AppointmentRescheduleRequestResolvedBy")
  appointmentCoordinationEventsRecorded PatientAppointmentCoordinationEvent[] @relation("AppointmentCoordinationEventRecordedBy")
  followupsCreated PatientFollowup[] @relation("PatientFollowupCreatedBy")
  patientProgramsCreated PatientProgram[] @relation("PatientProgramCreatedBy")
  patientBaselinesRecorded PatientBaseline[] @relation("PatientBaselineRecordedBy")
  patientClassificationsUpdated PatientClassification[] @relation("PatientClassificationUpdatedBy")
  patientClassificationHistoryChanged PatientClassificationHistory[] @relation("PatientClassificationHistoryChangedBy")
  patientServiceOfferingsCreated HospitalServiceOffering[] @relation("HospitalServiceOfferingCreatedBy")
  patientServiceOfferingsUpdated HospitalServiceOffering[] @relation("HospitalServiceOfferingUpdatedBy")
  patientServiceRequestsRequested PatientServiceRequest[] @relation("PatientServiceRequestRequester")
  patientServiceRequestsPreferredOsm PatientServiceRequest[] @relation("PatientServiceRequestPreferredOsm")
  patientServiceRequestsReviewed PatientServiceRequest[] @relation("PatientServiceRequestReviewer")
  patientServiceRequestsStarted PatientServiceRequest[] @relation("PatientServiceRequestStarter")
  patientServiceRequestsWithdrawn PatientServiceRequest[] @relation("PatientServiceRequestWithdrawer")
  patientAccessRequestsReviewed PatientAccessRequest[] @relation("PatientAccessRequestReviewer")
  patientAccessRequestsResolved PatientAccessRequest[] @relation("PatientAccessRequestResolvedUser")
  patientFinalAssessmentsRecorded PatientFinalAssessment[] @relation("PatientFinalAssessmentRecordedBy")
  patientProgramRoundActivitiesRecorded PatientProgramRoundActivity[] @relation("PatientProgramRoundActivityRecordedBy")
  patientProgramRoundVitalsRecorded PatientProgramRoundVitals[] @relation("PatientProgramRoundVitalsRecordedBy")
  patientProgramRoundCompletions PatientProgramRoundCompletion[] @relation("PatientProgramRoundCompletionCompletedBy")
  patientProgramRoundStepSkips PatientProgramRoundStepSkip[] @relation("PatientProgramRoundStepSkipSkippedBy")
  patientEvidenceArtifactsCreated PatientEvidenceArtifact[] @relation("PatientEvidenceArtifactCreatedBy")
  patientProgramServiceOneRoutinesRecorded PatientProgramServiceOneRoutine[] @relation("PatientProgramServiceOneRoutineRecordedBy")
  patientProgramServiceOneFloatingChartsRecorded PatientProgramServiceOneFloatingChart[] @relation("PatientProgramServiceOneFloatingChartRecordedBy")
  patientProgramServiceOneDreamCardsRecorded PatientProgramServiceOneDreamCard[] @relation("PatientProgramServiceOneDreamCardRecordedBy")
  patientProgramServiceOneConfidencesRecorded PatientProgramServiceOneConfidence[] @relation("PatientProgramServiceOneConfidenceRecordedBy")
  auditEvents AuditEvent[]
  lineAccountBindings LineAccountBinding[]
  lineAccountActionIntents LineAccountActionIntent[]
  lineAppointmentNotificationPreference LineAppointmentNotificationPreference?
  appointmentLineNotificationIntents AppointmentLineNotification[] @relation("AppointmentLineNotificationRecipient")
  contactSetting UserContactSetting?
  lineMedicationReminderPreference LineMedicationReminderPreference?
  medicationLineReminderIntents MedicationLineReminderNotification[] @relation("MedicationLineReminderRecipient")
  supportReports SupportReport[] @relation("SupportReportReporter")
  supportReportsUpdated SupportReport[] @relation("SupportReportStatusUpdater")
  hospitalOnboardingApplications HospitalOnboardingApplication[] @relation("HospitalOnboardingApplicant")
  hospitalOnboardingReviews     HospitalOnboardingApplication[] @relation("HospitalOnboardingReviewer")
  takeoverLock        UserTakeoverLock?  @relation("UserTakeoverLockTarget")
  takeoverLocksIssued UserTakeoverLock[] @relation("UserTakeoverLockActor")

  // Supports a composite FK that keeps an invitation bound to this exact User + Person pair.
  @@unique([id, personId])
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Hospital {
  serviceAreaEligibility HospitalServiceAreaEligibility?
  managedServiceAreas HospitalServiceArea[] @relation("ServiceAreaParent")
  serviceAreaAssignments HospitalServiceArea[] @relation("ServiceAreaChild")
  workforceBulkSubmissions WorkforceBulkSubmission[]
  workforceActivationContexts WorkforceActivation[] @relation("WorkforceActivationHospital")
  accountRecoveries AccountRecovery[] @relation("AccountRecoveryHospital")
  userTakeoverLocks UserTakeoverLock[]
  id              String         @id @default(uuid()) @db.Uuid
  hospitalCode    String         @unique @db.VarChar(32)
  name            String         @db.VarChar(200)
  status          HospitalStatus @default(PENDING_VERIFICATION)
  selfRegistrationEnabled Boolean @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  // Set exactly while status = RETIRED (CHECK "Hospital_retirement_consistency").
  retiredAt       DateTime?      @db.Timestamptz(3)
  retiredByUserId String?        @db.Uuid
  retiredReason   String?        @db.VarChar(500)
  // Client submission nonce of the ADMIN registration (N1-D5); NULL for Hospitals registered before it.
  registrationNonce  String?     @unique @db.Uuid
  registeredByUserId String?     @db.Uuid
  // ADR-0018: the Parent whose OWNER registered this Child (provenance only; authority stays in HospitalServiceArea).
  registeredForParentHospitalId String? @db.Uuid
  registeredForParent Hospital? @relation("HospitalRegisteredForParent", fields: [registeredForParentHospitalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registeredChildren  Hospital[] @relation("HospitalRegisteredForParent")
  retirementEvents HospitalRetirementEvent[]
  retiredBy    User? @relation("HospitalRetiredBy", fields: [retiredByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  registeredBy User? @relation("HospitalRegisteredBy", fields: [registeredByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  memberships              HospitalMembership[]
  osmHospitalRelationships OsmHospitalRelationship[] @relation("OsmHospitalRelationships")
  patientRelationships     PatientHospitalRelationship[]
  patientActivations      PatientActivation[]
  onboardingApplications   HospitalOnboardingApplication[]
  serviceOfferings         HospitalServiceOffering[]
  patientAccessRequests    PatientAccessRequest[]
  contact                  HospitalContact?
  contents                 HospitalContent[]
  supportReports           SupportReport[]

  @@index([status, name])
  @@index([registeredForParentHospitalId])
}

enum HospitalRetirementEventKind {
  RETIRED
  RESTORED
}

// Append-only (trigger "HospitalRetirementEvent_append_only"): the reason of every retire/restore decision.
model HospitalRetirementEvent {
  id          String                      @id @default(uuid()) @db.Uuid
  hospitalId  String                      @db.Uuid
  kind        HospitalRetirementEventKind
  reason      String                      @db.VarChar(500)
  actorUserId String                      @db.Uuid
  createdAt   DateTime                    @default(now()) @db.Timestamptz(3)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  actor    User     @relation("HospitalRetirementActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hospitalId, createdAt])
}

// Network role set only by an audited Platform ADMIN decision (ADR-0015), never inferred from names/codes/hierarchy.
enum HospitalServiceAreaFacilityKind {
  PARENT
  CHILD
}

model HospitalServiceAreaEligibility {
  hospitalId String @id @db.Uuid
  kind HospitalServiceAreaFacilityKind
  verifiedAt DateTime @db.Timestamptz(3)
  // NULL = one-time system bootstrap from canonical Master placement (migration 20261030110000).
  classifiedByUserId String? @db.Uuid
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  classifiedBy User? @relation("NetworkRoleClassifier", fields: [classifiedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model HospitalServiceArea {
  id String @id @default(uuid()) @db.Uuid
  parentHospitalId String @db.Uuid
  childHospitalId String @db.Uuid
  createdByUserId String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  endedByUserId String? @db.Uuid
  endReason String? @db.VarChar(500)
  parent Hospital @relation("ServiceAreaParent", fields: [parentHospitalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  child Hospital @relation("ServiceAreaChild", fields: [childHospitalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy User @relation("ServiceAreaCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endedBy User? @relation("ServiceAreaEnder", fields: [endedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  ownerInvitations HospitalMembership[]

  // Partial active-child uniqueness and immutable-history trigger live in migration SQL.
  @@index([parentHospitalId, endedAt, id])
  @@index([childHospitalId, parentHospitalId])
}

model HospitalContact {
  id          String   @id @default(uuid()) @db.Uuid
  hospitalId  String   @unique @db.Uuid
  addressText String?  @db.VarChar(500)
  phoneNumber String?  @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model HospitalContent {
  id                 String                 @id @default(uuid()) @db.Uuid
  hospitalId         String                 @db.Uuid
  submissionNonce    String                 @db.Uuid
  title              String                 @db.VarChar(200)
  body               String                 @db.Text
  category           HospitalContentCategory
  sourceText         String?                @db.VarChar(1000)
  status             HospitalContentStatus  @default(DRAFT)
  firstPublishedAt   DateTime?              @db.Timestamptz(3)
  latestPublishedAt  DateTime?              @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  images   HospitalContentImage[]

  @@unique([hospitalId, submissionNonce], map: "HospitalContent_hospital_nonce_key")
  @@index([hospitalId, updatedAt(sort: Desc), id(sort: Desc)], map: "HospitalContent_publisher_order_idx")
  @@index([hospitalId, status, firstPublishedAt(sort: Desc), id(sort: Desc)], map: "HospitalContent_patient_order_idx")
  @@index([hospitalId, status, category, firstPublishedAt(sort: Desc), id(sort: Desc)], map: "HospitalContent_patient_category_order_idx")
}

model HospitalContentImage {
  id               String   @id @default(uuid()) @db.Uuid
  contentId        String   @db.Uuid
  uploadNonce      String   @db.Uuid
  storageObjectKey String   @unique @db.VarChar(512)
  mediaType        String   @db.VarChar(32)
  byteSize         Int
  contentSha256    String?  @db.Char(64)
  sortOrder        Int
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  content HospitalContent @relation(fields: [contentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([contentId, uploadNonce], map: "HospitalContentImage_content_nonce_key")
  @@unique([contentId, sortOrder], map: "HospitalContentImage_content_order_key")
  @@index([contentId, sortOrder, id], map: "HospitalContentImage_content_order_idx")
}

model UserContactSetting {
  userId    String   @id @db.Uuid
  email     String?  @db.VarChar(320)
  version   Int      @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model SupportReport {
  id                    String                @id @default(uuid()) @db.Uuid
  hospitalId            String                @db.Uuid
  reporterUserId        String                @db.Uuid
  statusUpdaterUserId   String?               @db.Uuid
  category              SupportReportCategory
  message               String                @db.VarChar(1000)
  status                SupportReportStatus   @default(NEW)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @db.Timestamptz(3)
  resolvedAt            DateTime?             @db.Timestamptz(3)

  hospital          Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reporter          User     @relation("SupportReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  statusUpdater     User?    @relation("SupportReportStatusUpdater", fields: [statusUpdaterUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hospitalId, status, createdAt(sort: Desc), id(sort: Desc)], map: "SupportReport_inbox_order_idx")
  @@index([reporterUserId, createdAt(sort: Desc)], map: "SupportReport_reporter_order_idx")
}

model HospitalMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  hospitalId     String           @db.Uuid
  membershipType MembershipType
  profession     Profession?
  status         MembershipStatus @default(PROVISIONED)
  selfRegisteredAt DateTime?      @db.Timestamptz(3)
  // Customer decision E1 (ก-15): OWNER-granted report export for a MEMBER; both set or both null (SQL CHECK).
  reportExportGrantedAt       DateTime? @db.Timestamptz(3)
  reportExportGrantedByUserId String?   @db.Uuid
  // ADR-0016: OWNER-granted read-only network Patient access for a MEMBER; both set or both null (SQL CHECK).
  networkPatientReadGrantedAt       DateTime? @db.Timestamptz(3)
  networkPatientReadGrantedByUserId String?   @db.Uuid
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // ADR-0018: Child OWNER invitation binding; all null for other memberships (SQL CHECK).
  invitedByUserId         String?   @db.Uuid
  invitedViaServiceAreaId String?   @db.Uuid
  invitationDeclinedAt    DateTime? @db.Timestamptz(3)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  invitedBy User? @relation("HospitalMembershipInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  invitedViaServiceArea HospitalServiceArea? @relation(fields: [invitedViaServiceAreaId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  reportExportGrantedByUser User? @relation("HospitalMembershipReportExportGrantedBy", fields: [reportExportGrantedByUserId], references: [id], onDelete: Restrict)
  networkPatientReadGrantedByUser User? @relation("HospitalMembershipNetworkPatientReadGrantedBy", fields: [networkPatientReadGrantedByUserId], references: [id], onDelete: Restrict)

  @@index([userId, hospitalId])
  @@index([hospitalId, status])
  @@index([hospitalId, createdAt, id])
  @@index([invitedViaServiceAreaId])
}

