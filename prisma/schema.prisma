model PatientGoalPlan {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  patientProgramId              String?  @db.Uuid
  createdByUserId               String   @db.Uuid
  sourceScreeningAssessmentId   String?  @db.Uuid
  // Workbook DoD BR-06: the Program Follow-up whose "ปรับแผน" answer produced this plan (at most one plan each).
  sourceFollowupId              String?  @unique @db.Uuid
  submissionNonce               String   @unique @db.Uuid
  templateKey                   String   @db.VarChar(64)
  templateVersion               String   @db.VarChar(64)
  roundNumber                   Int
  primaryGoalCode               String   @db.VarChar(64)
  primaryGoalNote               String?  @db.VarChar(1000)
  weeklyNote                    String?  @db.VarChar(2000)
  // R2-E (template booklet-v1): แผน "สุขภาพดี" ของฉัน. Null for legacy-prototype-v1 plans.
  goalWeightLossKg              Float?
  goalWaistCm                   Float?
  goalBloodSugarMgDl            Float?
  // D8: HbA1c target in %.
  goalHba1cPercent              Float?
  goalCustomText                String?  @db.VarChar(1000)
  foodPlanText                  String?  @db.VarChar(1000)
  foodStartDate                 DateTime? @db.Date
  foodNotSet                    Boolean?
  exercisePlanText              String?  @db.VarChar(1000)
  exerciseStartDate             DateTime? @db.Date
  exerciseNotSet                Boolean?
  problemsAfterOneMonth         String?  @db.VarChar(2000)
  patientSignatureName          String?  @db.VarChar(200)
  witnessSignatureName          String?  @db.VarChar(200)
  createdAt                     DateTime @default(now())

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  patientProgram              PatientProgram?             @relation("PatientProgramGoalPlans", fields: [patientProgramId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  createdByUser               User                       @relation("PatientGoalPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceScreeningAssessment   ScreeningAssessment?       @relation("GoalPlanSourceScreening", fields: [sourceScreeningAssessmentId], references: [id], onDelete: Restrict)
  sourceFollowup              PatientFollowup?           @relation("PatientGoalPlanSourceFollowup", fields: [sourceFollowupId, patientProgramId, patientHospitalRelationshipId], references: [id, patientProgramId, patientHospitalRelationshipId], onDelete: Restrict)
  items                       PatientGoalItem[]
  followupsSourced             PatientFollowup[]          @relation("PatientFollowupSourceGoalPlan")
  followupsSourcedProgramScoped PatientFollowup[]          @relation("PatientFollowupSourceGoalPlanProgramScoped")
