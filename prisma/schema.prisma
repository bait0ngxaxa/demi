generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  HOSPITAL
  OSM
  PATIENT
}

enum UserStatus {
  PROVISIONED
  INVITED
  ACTIVE
  SUSPENDED
}

enum LineWorkspaceRole {
  PATIENT
  OSM
  HOSPITAL
}

enum LineReachability {
  UNKNOWN
  FRIEND
  NOT_FRIEND
}

enum LineMenuSyncState {
  UNKNOWN
  APPLIED
  MISMATCH
  UNAVAILABLE
}

enum LineProviderCleanupState {
  PENDING
  CONFIRMED_CLEAN
  MISMATCH
  UNAVAILABLE
  UNKNOWN
}

enum LineAccountAction {
  LINK
  UNLINK
  RECOVERY
}

enum LineGrantApplicability {
  OBSERVED
  UNKNOWN
  PROVEN_ABSENT
}

enum LineTerminationOutcome {
  OBSERVED
  PENDING
  REMOTE_UNCONFIRMED
  REMOTE_CONFIRMED
}

enum LineTerminationReason {
  ATTEMPT_RESERVED
  TOKEN_UNAVAILABLE
  KNOWN_NOT_DISPATCHED
  POSSIBLY_DISPATCHED
  PROVIDER_REJECTED
  INVALID_RESPONSE
  PROVIDER_204
}

enum LineAccountActionOutcome {
  SUCCEEDED
  CONFLICT
  INELIGIBLE
  UNAUTHORIZED
}

enum LineWebhookEventType {
  FOLLOW
  UNFOLLOW
  RICHMENUSWITCH
  PATIENT_NEXT_APPOINTMENT
}

enum LineWebhookEventOutcome {
  APPLIED
  STALE
  IGNORED
  ACCEPTED
}

enum AccountRecoveryDeliveryChannel {
  ASSISTED
}

enum HospitalStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum HospitalContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum HospitalContentCategory {
  NCD
  FOOD
  EXERCISE
  OTHER
}

enum HospitalOnboardingApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipType {
  OWNER
  MEMBER
}

enum Profession {
  DOCTOR
  NURSE
  COORDINATOR
  OTHER
}

enum MembershipStatus {
  PROVISIONED
  INVITED
  ACTIVE
  SUSPENDED
}

enum PatientClassificationType {
  RISK
  DIABETES
}

enum PatientClassificationSource {
  ROSTER_IMPORT
  MANUAL
}

enum WorkforceActivationMode {
  REMOTE
  ASSISTED
}

enum AppointmentType {
  FOLLOW_UP
  CONSULTATION
}

enum AppointmentLocationType {
  CLINIC
  ONLINE
  HOME_VISIT
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentInteractionSource {
  PATIENT_SELF
  OSM_PROXY
}

enum AppointmentCancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum AppointmentLineNotificationEventKind {
  CREATED
  RESCHEDULED
  CANCELLED
}

enum AppointmentLineNotificationState {
  PENDING
  CLAIMED
  RETRY_SCHEDULED
  PROVIDER_ACCEPTED
  SUPPRESSED
  PERMANENT_FAILURE
  OUTCOME_UNKNOWN
}

enum AppointmentLineNotificationOutcome {
  ACCEPTED
  DUPLICATE_ACCEPTED
  TRANSIENT_HTTP_FAILURE
  AMBIGUOUS_TRANSPORT_FAILURE
  PERMANENT_HTTP_FAILURE
  RETRY_WINDOW_EXPIRED
  STALE_SOURCE
  AUTHORITY_CHANGED
  OPT_IN_REVOKED
  LINE_INELIGIBLE
  ROLLOUT_CLOSED
  OPT_IN_REQUIRED_AT_SOURCE
  PATIENT_INELIGIBLE_AT_SOURCE
  LINE_BINDING_INELIGIBLE_AT_SOURCE
  PROCESS_OUTCOME_UNKNOWN
}

enum FollowupActivityProgressStatus {
  DONE
  PARTIAL
  NOT_DONE
  NOT_APPLICABLE
}

enum PatientProgramStatus {
  ACTIVE
  COMPLETED
}

enum PatientServiceCode {
  SCREENING
  FOLLOW_UP
  EMPOWERMENT
}

enum PatientServiceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  STARTED
  WITHDRAWN
}

enum PatientAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  ACTIVATION_ISSUED
  COMPLETED
}

enum PatientAccessRequestResolution {
  ACTIVATION_COMPLETED
  ALREADY_ACTIVE
}

enum CaregiverInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

enum CaregiverAppointmentGrantStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum CaregiverRelationshipStatus {
  ACTIVE
  REVOKED
  WITHDRAWN
}

model Person {
  id              String   @id @default(uuid()) @db.Uuid
  identityKeyHash String   @unique @db.VarChar(64)
  givenName       String?  @db.VarChar(120)
  familyName      String?  @db.VarChar(120)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User?
  patientProfile PatientProfile?
  patientAccessRequestsResolved PatientAccessRequest[] @relation("PatientAccessRequestResolvedPerson")

  @@index([familyName, givenName])
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  personId    String     @unique @db.Uuid
  authSubject String?    @unique @db.VarChar(255)
  status      UserStatus @default(PROVISIONED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  person      Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  roles       UserRole[]
  memberships HospitalMembership[]
  osmHospitalRelationships OsmHospitalRelationship[] @relation("OsmHospitalRelationships")
  workforceActivations WorkforceActivation[] @relation("WorkforceActivationTarget")
  workforceActivationsCreated WorkforceActivation[] @relation("WorkforceActivationCreator")
  patientActivations PatientActivation[] @relation("PatientActivationTarget")
  patientActivationsCreated PatientActivation[] @relation("PatientActivationCreator")
  accountRecoveries AccountRecovery[] @relation("AccountRecoveryTarget")
  accountRecoveriesIssued AccountRecovery[] @relation("AccountRecoveryIssuer")
  caregiverInvitationsReceived CaregiverInvitation[] @relation("CaregiverInvitationCaregiver")
  caregiverInvitationsIssued CaregiverInvitation[] @relation("CaregiverInvitationIssuer")
  caregiverInvitationsRevoked CaregiverInvitation[] @relation("CaregiverInvitationRevoker")
  caregiverRelationships CaregiverRelationship[] @relation("CaregiverRelationshipCaregiver")
  caregiverRelationshipsRevoked CaregiverRelationship[] @relation("CaregiverRelationshipRevoker")
  appointmentGrants CaregiverAppointmentGrant[] @relation("AppointmentGrantCaregiver")
  appointmentGrantsProposed CaregiverAppointmentGrant[] @relation("AppointmentGrantProposer")
  appointmentGrantsAccepted CaregiverAppointmentGrant[] @relation("AppointmentGrantAccepter")
  appointmentGrantsRevoked CaregiverAppointmentGrant[] @relation("AppointmentGrantRevoker")
  patientOsmAssignments PatientOsmAssignment[] @relation("PatientOsmAssignments")
  patientOsmAssignmentsCreated PatientOsmAssignment[] @relation("PatientOsmAssignmentsCreated")
  patientOsmAssignmentsEnded PatientOsmAssignment[] @relation("PatientOsmAssignmentsEnded")
  screeningAssessmentsConducted ScreeningAssessment[] @relation("ScreeningAssessmentConductedBy")
  goalPlansCreated PatientGoalPlan[] @relation("PatientGoalPlanCreatedBy")
  appointmentsResponsible PatientAppointment[] @relation("PatientAppointmentResponsible")
  appointmentsCreated PatientAppointment[] @relation("PatientAppointmentCreatedBy")
  appointmentAcknowledgementsRecorded PatientAppointmentAcknowledgement[] @relation("AppointmentAcknowledgementRecordedBy")
  appointmentCancellationRequestsSubmitted PatientAppointmentCancellationRequest[] @relation("AppointmentCancellationRequestSubmittedBy")
  appointmentCancellationRequestsResolved PatientAppointmentCancellationRequest[] @relation("AppointmentCancellationRequestResolvedBy")
  appointmentCoordinationEventsRecorded PatientAppointmentCoordinationEvent[] @relation("AppointmentCoordinationEventRecordedBy")
  followupsCreated PatientFollowup[] @relation("PatientFollowupCreatedBy")
  patientProgramsCreated PatientProgram[] @relation("PatientProgramCreatedBy")
  patientBaselinesRecorded PatientBaseline[] @relation("PatientBaselineRecordedBy")
  patientClassificationsUpdated PatientClassification[] @relation("PatientClassificationUpdatedBy")
  patientClassificationHistoryChanged PatientClassificationHistory[] @relation("PatientClassificationHistoryChangedBy")
  patientServiceOfferingsCreated HospitalServiceOffering[] @relation("HospitalServiceOfferingCreatedBy")
  patientServiceOfferingsUpdated HospitalServiceOffering[] @relation("HospitalServiceOfferingUpdatedBy")
  patientServiceRequestsRequested PatientServiceRequest[] @relation("PatientServiceRequestRequester")
  patientServiceRequestsPreferredOsm PatientServiceRequest[] @relation("PatientServiceRequestPreferredOsm")
  patientServiceRequestsReviewed PatientServiceRequest[] @relation("PatientServiceRequestReviewer")
  patientServiceRequestsStarted PatientServiceRequest[] @relation("PatientServiceRequestStarter")
  patientServiceRequestsWithdrawn PatientServiceRequest[] @relation("PatientServiceRequestWithdrawer")
  patientAccessRequestsReviewed PatientAccessRequest[] @relation("PatientAccessRequestReviewer")
  patientAccessRequestsResolved PatientAccessRequest[] @relation("PatientAccessRequestResolvedUser")
  patientFinalAssessmentsRecorded PatientFinalAssessment[] @relation("PatientFinalAssessmentRecordedBy")
  patientEvidenceArtifactsCreated PatientEvidenceArtifact[] @relation("PatientEvidenceArtifactCreatedBy")
  patientProgramServiceOneRoutinesRecorded PatientProgramServiceOneRoutine[] @relation("PatientProgramServiceOneRoutineRecordedBy")
  patientProgramServiceOneFloatingChartsRecorded PatientProgramServiceOneFloatingChart[] @relation("PatientProgramServiceOneFloatingChartRecordedBy")
  patientProgramServiceOneDreamCardsRecorded PatientProgramServiceOneDreamCard[] @relation("PatientProgramServiceOneDreamCardRecordedBy")
  patientProgramServiceOneConfidencesRecorded PatientProgramServiceOneConfidence[] @relation("PatientProgramServiceOneConfidenceRecordedBy")
  auditEvents AuditEvent[]
  lineAccountBindings LineAccountBinding[]
  lineAccountActionIntents LineAccountActionIntent[]
  lineAppointmentNotificationPreference LineAppointmentNotificationPreference?
  appointmentLineNotificationIntents AppointmentLineNotification[] @relation("AppointmentLineNotificationRecipient")
  hospitalOnboardingApplications HospitalOnboardingApplication[] @relation("HospitalOnboardingApplicant")
  hospitalOnboardingReviews     HospitalOnboardingApplication[] @relation("HospitalOnboardingReviewer")

  // Supports a composite FK that keeps an invitation bound to this exact User + Person pair.
  @@unique([id, personId])
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Hospital {
  id              String         @id @default(uuid()) @db.Uuid
  hospitalCode    String         @unique @db.VarChar(32)
  name            String         @db.VarChar(200)
  status          HospitalStatus @default(PENDING_VERIFICATION)
  parentHospitalId String?       @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  memberships              HospitalMembership[]
  osmHospitalRelationships OsmHospitalRelationship[] @relation("OsmHospitalRelationships")
  patientRelationships     PatientHospitalRelationship[]
  patientActivations      PatientActivation[]
  onboardingApplications   HospitalOnboardingApplication[]
  serviceOfferings         HospitalServiceOffering[]
  patientAccessRequests    PatientAccessRequest[]
  contact                  HospitalContact?
  contents                 HospitalContent[]
  parentHospital           Hospital? @relation("HospitalHierarchy", fields: [parentHospitalId], references: [id], onDelete: Restrict)
  childHospitals            Hospital[] @relation("HospitalHierarchy")

  @@index([status, name])
}

model HospitalContact {
  id          String   @id @default(uuid()) @db.Uuid
  hospitalId  String   @unique @db.Uuid
  addressText String?  @db.VarChar(500)
  phoneNumber String?  @db.VarChar(32)
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  updatedAt   DateTime @updatedAt @db.Timestamp(3)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
}

model HospitalContent {
  id                 String                 @id @default(uuid()) @db.Uuid
  hospitalId         String                 @db.Uuid
  submissionNonce    String                 @db.Uuid
  title              String                 @db.VarChar(200)
  body               String                 @db.Text
  category           HospitalContentCategory
  sourceText         String?                @db.VarChar(1000)
  status             HospitalContentStatus  @default(DRAFT)
  firstPublishedAt   DateTime?              @db.Timestamptz(3)
  latestPublishedAt  DateTime?              @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hospitalId, submissionNonce], map: "HospitalContent_hospital_nonce_key")
  @@index([hospitalId, updatedAt(sort: Desc), id(sort: Desc)], map: "HospitalContent_publisher_order_idx")
  @@index([hospitalId, status, firstPublishedAt(sort: Desc), id(sort: Desc)], map: "HospitalContent_patient_order_idx")
  @@index([hospitalId, status, category, firstPublishedAt(sort: Desc), id(sort: Desc)], map: "HospitalContent_patient_category_order_idx")
}

model HospitalMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  hospitalId     String           @db.Uuid
  membershipType MembershipType
  profession     Profession?
  status         MembershipStatus @default(PROVISIONED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([userId, hospitalId])
  @@index([hospitalId, status])
}

model PatientProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  personId              String    @unique @db.Uuid
  dateOfBirth           DateTime? @db.Date
  gender                String?   @db.VarChar(64)
  phoneNumber           String?   @db.VarChar(32)
  addressText           String?   @db.VarChar(500)
  emergencyContactName  String?   @db.VarChar(200)
  emergencyContactPhone String?   @db.VarChar(32)
  occupation            String?   @db.VarChar(200)
  educationLevel        String?   @db.VarChar(200)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  person                Person                       @relation(fields: [personId], references: [id], onDelete: Restrict)
  hospitalRelationships PatientHospitalRelationship[]
  caregiverInvitations CaregiverInvitation[]
  caregiverRelationships CaregiverRelationship[]
  appointmentGrants CaregiverAppointmentGrant[]
  patientClassification PatientClassification?
  classificationHistory PatientClassificationHistory[]
  personalMedications PersonalMedication[]
  personalMealEntries PersonalMealEntry[]
  personalMealCreateReceipts PersonalMealCreateReceipt[]
  personalExerciseEntries PersonalExerciseEntry[]
  personalExerciseCreateReceipts PersonalExerciseCreateReceipt[]
  personalWeightGoal PersonalWeightGoal?
  personalWeightGoalCreateReceipts PersonalWeightGoalCreateReceipt[]

  @@unique([id, personId])
}

enum PersonalMedicationStatus {
  ACTIVE
  STOPPED
}

enum PersonalMealCategory {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model PersonalMealEntry {
  id String @id @default(uuid()) @db.Uuid
  patientProfileId String @db.Uuid
  category PersonalMealCategory
  occurredOn DateTime @db.Date
  description String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([patientProfileId, occurredOn(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "PersonalMealEntry_history_order_idx")
}

model PersonalMealCreateReceipt {
  patientProfileId String @db.Uuid
  submissionNonce String @db.Uuid
  // Scalar locator deliberately survives Meal deletion; no Meal FK or payload.
  mealEntryId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([patientProfileId, submissionNonce])
}

model PersonalExerciseEntry {
  id String @id @default(uuid()) @db.Uuid
  patientProfileId String @db.Uuid
  activityName String @db.VarChar(120)
  occurredOn DateTime @db.Date
  durationMinutes Int? @db.Integer
  note String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([patientProfileId, occurredOn(sort: Desc), createdAt(sort: Desc), id(sort: Desc)], map: "PersonalExerciseEntry_history_order_idx")
}

model PersonalExerciseCreateReceipt {
  patientProfileId String @db.Uuid
  submissionNonce String @db.Uuid
  // Scalar locator survives Exercise deletion; no Exercise FK or payload.
  exerciseEntryId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([patientProfileId, submissionNonce])
}

model PersonalWeightGoal {
  id String @id @default(uuid()) @db.Uuid
  patientProfileId String @unique @db.Uuid
  targetWeightKg Decimal @db.Decimal(10, 3)
  targetDate DateTime? @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("PersonalWeightGoal")
}

model PersonalWeightGoalCreateReceipt {
  patientProfileId String @db.Uuid
  submissionNonce String @db.Uuid
  // Scalar locator deliberately survives Weight Goal deletion; no target FK or payload.
  intendedWeightGoalId String @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([patientProfileId, submissionNonce])
}

model PersonalMedication {
  id String @id @default(uuid()) @db.Uuid
  patientProfileId String @db.Uuid
  medicationName String @db.VarChar(200)
  instructionText String? @db.VarChar(2000)
  status PersonalMedicationStatus @default(ACTIVE)
  stoppedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  schedules MedicationSchedule[]

  @@index([patientProfileId, status, createdAt(sort: Desc), id(sort: Desc)], map: "PersonalMedication_active_order_idx")
  @@index([patientProfileId, status, stoppedAt(sort: Desc), id(sort: Desc)], map: "PersonalMedication_stopped_order_idx")
}

model MedicationSchedule {
  id                   String   @id @default(uuid()) @db.Uuid
  personalMedicationId String   @db.Uuid
  localTime            DateTime @db.Time(6)
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  personalMedication PersonalMedication @relation(fields: [personalMedicationId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([personalMedicationId, localTime], map: "MedicationSchedule_medication_time_key")
}

model PatientClassification {
  id               String                    @id @default(uuid()) @db.Uuid
  patientProfileId String                    @unique @db.Uuid
  classification   PatientClassificationType
  updatedByUserId  String                    @db.Uuid
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  updatedByUser  User           @relation("PatientClassificationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([classification])
  @@index([updatedByUserId, updatedAt])
}

model PatientClassificationHistory {
  id                 String                    @id @default(uuid()) @db.Uuid
  patientProfileId   String                    @db.Uuid
  fromClassification PatientClassificationType?
  toClassification   PatientClassificationType
  changedAt          DateTime                  @default(now()) @db.Timestamptz(3)
  changedByUserId    String                    @db.Uuid
  source             PatientClassificationSource

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  changedByUser  User           @relation("PatientClassificationHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, changedAt])
  @@index([changedByUserId, changedAt])
}

model PatientHospitalRelationship {
  id               String   @id @default(uuid()) @db.Uuid
  patientProfileId String   @db.Uuid
  hospitalId       String   @db.Uuid
  hospitalNumber   String?  @db.VarChar(64)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  appointmentGrants CaregiverAppointmentGrant[]
  hospitalProfile PatientHospitalProfile?
  accountRecoveries AccountRecovery[]
  osmAssignments PatientOsmAssignment[]
  screeningAssessments ScreeningAssessment[]
  goalPlans PatientGoalPlan[]
  appointments PatientAppointment[]
  followups PatientFollowup[]
  programs PatientProgram[]
  finalAssessments PatientFinalAssessment[]
  baseline             PatientBaseline?
  evidenceArtifacts    PatientEvidenceArtifact[]
  serviceRequests      PatientServiceRequest[]
  patientAccessRequestsResolved PatientAccessRequest[] @relation("PatientAccessRequestResolvedRelationship")

  @@unique([patientProfileId, hospitalId])
  @@unique([id, hospitalId])
  @@unique([id, patientProfileId])
  @@index([hospitalId])
  @@index([hospitalId, hospitalNumber])
}

model PatientHospitalProfile {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @unique @db.Uuid
  gender                        String?  @db.VarChar(64)
  phoneNumber                   String?  @db.VarChar(32)
  addressText                   String?  @db.VarChar(500)
  emergencyContactName          String?  @db.VarChar(200)
  emergencyContactPhone         String?  @db.VarChar(32)
  occupation                    String?  @db.VarChar(200)
  educationLevel                String?  @db.VarChar(200)
  version                       Int      @default(1)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  relationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Cascade)
}

model CaregiverInvitation {
  id                         String                    @id @default(uuid()) @db.Uuid
  patientProfileId           String                    @db.Uuid
  caregiverUserId            String                    @db.Uuid
  caregiverPersonId          String                    @db.Uuid
  issuedByUserId              String                    @db.Uuid
  tokenHash                   String                    @unique @db.VarChar(64)
  status                      CaregiverInvitationStatus @default(PENDING)
  acceptanceContractVersion   String?                   @db.VarChar(64)
  issuedAt                    DateTime                  @default(now()) @db.Timestamptz(3)
  expiresAt                   DateTime                  @db.Timestamptz(3)
  acceptedAt                  DateTime?                 @db.Timestamptz(3)
  rejectedAt                  DateTime?                 @db.Timestamptz(3)
  revokedAt                   DateTime?                 @db.Timestamptz(3)
  expiredAt                   DateTime?                 @db.Timestamptz(3)
  createdAt                   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                  @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  caregiverUser User @relation("CaregiverInvitationCaregiver", fields: [caregiverUserId, caregiverPersonId], references: [id, personId], onDelete: Restrict, onUpdate: Restrict)
  issuedByUser User @relation("CaregiverInvitationIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("CaregiverInvitationRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  revokedByUserId String? @db.Uuid
  relationship CaregiverRelationship?

  @@index([patientProfileId, createdAt])
  @@index([caregiverUserId, createdAt])
  // Additional source-pair FK is enforced by the corrective SQL migration.
  @@unique([id, patientProfileId, caregiverUserId], map: "CaregiverInvitation_source_pair_key")
  @@index([status, expiresAt])
}

model CaregiverRelationship {
  id                String                       @id @default(uuid()) @db.Uuid
  patientProfileId  String                       @db.Uuid
  caregiverUserId   String                       @db.Uuid
  sourceInvitationId String                      @unique @db.Uuid
  status            CaregiverRelationshipStatus @default(ACTIVE)
  activatedAt       DateTime                     @db.Timestamptz(3)
  revokedAt         DateTime?                    @db.Timestamptz(3)
  revokedByUserId   String?                      @db.Uuid
  withdrawnAt       DateTime?                    @db.Timestamptz(3)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  caregiverUser User @relation("CaregiverRelationshipCaregiver", fields: [caregiverUserId], references: [id], onDelete: Restrict)
