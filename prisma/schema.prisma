// Phase A (WB-DF-01..03): ledger of whiteboard activities per numbered round of a Program.
model PatientProgramRoundActivity {
  id                            String                              @id @default(uuid()) @db.Uuid
  patientProgramId              String                              @db.Uuid
  patientHospitalRelationshipId String                              @db.Uuid
