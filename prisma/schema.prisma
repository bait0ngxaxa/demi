generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  HOSPITAL
  OSM
  PATIENT
}

enum UserStatus {
  PROVISIONED
  INVITED
  ACTIVE
  SUSPENDED
}

enum HospitalStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum HospitalOnboardingApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipType {
  OWNER
  MEMBER
}

enum Profession {
  DOCTOR
  NURSE
  COORDINATOR
  OTHER
}

enum MembershipStatus {
  PROVISIONED
  INVITED
  ACTIVE
  SUSPENDED
}

enum WorkforceActivationMode {
  REMOTE
  ASSISTED
}

enum AppointmentType {
  FOLLOW_UP
  CONSULTATION
}

enum AppointmentLocationType {
  CLINIC
  ONLINE
  HOME_VISIT
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum FollowupActivityProgressStatus {
  DONE
  PARTIAL
  NOT_DONE
  NOT_APPLICABLE
}

enum PatientProgramStatus {
  ACTIVE
  COMPLETED
}

model Person {
  id              String   @id @default(uuid()) @db.Uuid
  identityKeyHash String   @unique @db.VarChar(64)
  givenName       String?  @db.VarChar(120)
  familyName      String?  @db.VarChar(120)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User?
  patientProfile PatientProfile?

  @@index([familyName, givenName])
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  personId    String     @unique @db.Uuid
  authSubject String?    @unique @db.VarChar(255)
  status      UserStatus @default(PROVISIONED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  person      Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  roles       UserRole[]
  memberships HospitalMembership[]
  osmHospitalRelationships OsmHospitalRelationship[] @relation("OsmHospitalRelationships")
  workforceActivations WorkforceActivation[] @relation("WorkforceActivationTarget")
  workforceActivationsCreated WorkforceActivation[] @relation("WorkforceActivationCreator")
  patientActivations PatientActivation[] @relation("PatientActivationTarget")
  patientActivationsCreated PatientActivation[] @relation("PatientActivationCreator")
  patientOsmAssignments PatientOsmAssignment[] @relation("PatientOsmAssignments")
  patientOsmAssignmentsCreated PatientOsmAssignment[] @relation("PatientOsmAssignmentsCreated")
  patientOsmAssignmentsEnded PatientOsmAssignment[] @relation("PatientOsmAssignmentsEnded")
  screeningAssessmentsConducted ScreeningAssessment[] @relation("ScreeningAssessmentConductedBy")
  goalPlansCreated PatientGoalPlan[] @relation("PatientGoalPlanCreatedBy")
  appointmentsResponsible PatientAppointment[] @relation("PatientAppointmentResponsible")
  appointmentsCreated PatientAppointment[] @relation("PatientAppointmentCreatedBy")
  followupsCreated PatientFollowup[] @relation("PatientFollowupCreatedBy")
  patientProgramsCreated PatientProgram[] @relation("PatientProgramCreatedBy")
  patientBaselinesRecorded PatientBaseline[] @relation("PatientBaselineRecordedBy")
  patientEvidenceArtifactsCreated PatientEvidenceArtifact[] @relation("PatientEvidenceArtifactCreatedBy")
  patientProgramServiceOneRoutinesRecorded PatientProgramServiceOneRoutine[] @relation("PatientProgramServiceOneRoutineRecordedBy")
  patientProgramServiceOneFloatingChartsRecorded PatientProgramServiceOneFloatingChart[] @relation("PatientProgramServiceOneFloatingChartRecordedBy")
  patientProgramServiceOneDreamCardsRecorded PatientProgramServiceOneDreamCard[] @relation("PatientProgramServiceOneDreamCardRecordedBy")
  patientProgramServiceOneConfidencesRecorded PatientProgramServiceOneConfidence[] @relation("PatientProgramServiceOneConfidenceRecordedBy")
  auditEvents AuditEvent[]
  hospitalOnboardingApplications HospitalOnboardingApplication[] @relation("HospitalOnboardingApplicant")
  hospitalOnboardingReviews     HospitalOnboardingApplication[] @relation("HospitalOnboardingReviewer")
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Hospital {
  id              String         @id @default(uuid()) @db.Uuid
  hospitalCode    String         @unique @db.VarChar(32)
  name            String         @db.VarChar(200)
  status          HospitalStatus @default(PENDING_VERIFICATION)
  parentHospitalId String?       @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  memberships              HospitalMembership[]
  osmHospitalRelationships OsmHospitalRelationship[] @relation("OsmHospitalRelationships")
  patientRelationships     PatientHospitalRelationship[]
  patientActivations      PatientActivation[]
  onboardingApplications   HospitalOnboardingApplication[]
  parentHospital           Hospital? @relation("HospitalHierarchy", fields: [parentHospitalId], references: [id], onDelete: Restrict)
  childHospitals            Hospital[] @relation("HospitalHierarchy")

  @@index([status, name])
}

model HospitalMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  hospitalId     String           @db.Uuid
  membershipType MembershipType
  profession     Profession?
  status         MembershipStatus @default(PROVISIONED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([userId, hospitalId])
  @@index([hospitalId, status])
}

model PatientProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  personId              String    @unique @db.Uuid
  dateOfBirth           DateTime? @db.Date
  gender                String?   @db.VarChar(64)
  phoneNumber           String?   @db.VarChar(32)
  addressText           String?   @db.VarChar(500)
  emergencyContactName  String?   @db.VarChar(200)
  emergencyContactPhone String?   @db.VarChar(32)
  occupation            String?   @db.VarChar(200)
  educationLevel        String?   @db.VarChar(200)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  person                Person                       @relation(fields: [personId], references: [id], onDelete: Restrict)
  hospitalRelationships PatientHospitalRelationship[]
}

model PatientHospitalRelationship {
  id               String   @id @default(uuid()) @db.Uuid
  patientProfileId String   @db.Uuid
  hospitalId       String   @db.Uuid
  hospitalNumber   String?  @db.VarChar(64)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  osmAssignments PatientOsmAssignment[]
  screeningAssessments ScreeningAssessment[]
  goalPlans PatientGoalPlan[]
  appointments PatientAppointment[]
  followups PatientFollowup[]
  programs PatientProgram[]
  baseline             PatientBaseline?
  evidenceArtifacts    PatientEvidenceArtifact[]

  @@unique([patientProfileId, hospitalId])
  @@index([hospitalId])
  @@index([hospitalId, hospitalNumber])
}

model PatientOsmAssignment {
  id                            String    @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String    @db.Uuid
  osmUserId                     String    @db.Uuid
  assignedByUserId              String    @db.Uuid
  createdAt                     DateTime  @default(now())
  endedAt                       DateTime?
  endedByUserId                 String?   @db.Uuid

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  osmUser                     User                       @relation("PatientOsmAssignments", fields: [osmUserId], references: [id], onDelete: Restrict)
  assignedByUser              User                       @relation("PatientOsmAssignmentsCreated", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  endedByUser                 User?                      @relation("PatientOsmAssignmentsEnded", fields: [endedByUserId], references: [id], onDelete: Restrict)

  @@index([patientHospitalRelationshipId, createdAt])
  @@index([osmUserId, endedAt])
}

model ScreeningAssessment {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  conductedByUserId             String   @db.Uuid
  submissionNonce               String   @unique @db.Uuid
  questionSetKey                String   @db.VarChar(64)
  questionSetVersion            String   @db.VarChar(64)
  scoringVersion                String   @db.VarChar(64)
  responses                     Json
  result                        Json
  submittedAt                   DateTime @default(now())
  createdAt                     DateTime @default(now())

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  conductedByUser             User                       @relation("ScreeningAssessmentConductedBy", fields: [conductedByUserId], references: [id], onDelete: Restrict)
  goalPlansSourced             PatientGoalPlan[]          @relation("GoalPlanSourceScreening")

  @@index([patientHospitalRelationshipId, submittedAt])
  @@index([conductedByUserId, submittedAt])
}

model PatientGoalPlan {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  createdByUserId               String   @db.Uuid
  sourceScreeningAssessmentId   String?  @db.Uuid
  submissionNonce               String   @unique @db.Uuid
  templateKey                   String   @db.VarChar(64)
  templateVersion               String   @db.VarChar(64)
  roundNumber                   Int
  primaryGoalCode               String   @db.VarChar(64)
  primaryGoalNote               String?  @db.VarChar(1000)
  weeklyNote                    String?  @db.VarChar(2000)
  createdAt                     DateTime @default(now())

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  createdByUser               User                       @relation("PatientGoalPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceScreeningAssessment   ScreeningAssessment?       @relation("GoalPlanSourceScreening", fields: [sourceScreeningAssessmentId], references: [id], onDelete: Restrict)
  items                       PatientGoalItem[]
  followupsSourced             PatientFollowup[]          @relation("PatientFollowupSourceGoalPlan")

  @@unique([patientHospitalRelationshipId, roundNumber])
  @@index([patientHospitalRelationshipId, createdAt])
}

model PatientGoalItem {
  id          String   @id @default(uuid()) @db.Uuid
  goalPlanId  String   @db.Uuid
  activityCode String  @db.VarChar(64)
  targetDays  Int
  targetValue Float?
  targetUnit  String?  @db.VarChar(32)
  sortOrder   Int
  createdAt   DateTime @default(now())

  goalPlan PatientGoalPlan @relation(fields: [goalPlanId], references: [id], onDelete: Cascade)

  @@unique([goalPlanId, activityCode])
  @@index([goalPlanId, sortOrder])
}

model PatientAppointment {
  id                            String                  @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String                  @db.Uuid
  responsibleUserId            String?                 @db.Uuid
  createdByUserId               String                  @db.Uuid
  type                          AppointmentType
  scheduledAt                   DateTime                @db.Timestamptz(3)
  durationMinutes               Int?
  locationType                  AppointmentLocationType?
  locationDetail                String?                 @db.VarChar(500)
  note                          String?                 @db.VarChar(2000)
  status                        AppointmentStatus       @default(SCHEDULED)
  submissionNonce               String                  @unique @db.Uuid
  creationRequestHash           String?                 @db.VarChar(64)
  createdAt                     DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                @updatedAt @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  responsibleUser             User?                      @relation("PatientAppointmentResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdByUser               User                       @relation("PatientAppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  followups                   PatientFollowup[]

  @@index([patientHospitalRelationshipId, scheduledAt])
  @@index([responsibleUserId])
  @@index([status])
}

model PatientFollowup {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  appointmentId                String?  @db.Uuid
  sourceGoalPlanId              String?  @db.Uuid
  createdByUserId               String   @db.Uuid
  roundNumber                  Int
  submissionNonce              String   @unique @db.Uuid
  submissionRequestHash        String   @db.VarChar(64)
  recordedAt                   DateTime @default(now()) @db.Timestamptz(3)
  weight                       Float?
  waistCircumference           Float?
  systolicBloodPressure        Float?
  diastolicBloodPressure       Float?
  bloodSugar                   Float?
  confidenceScore              Int?
  reflectionNote               String?  @db.VarChar(2000)
  confidencePlan               String?  @db.VarChar(2000)
  generalNote                  String?  @db.VarChar(2000)
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  appointment                 PatientAppointment?         @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  sourceGoalPlan              PatientGoalPlan?            @relation("PatientFollowupSourceGoalPlan", fields: [sourceGoalPlanId], references: [id], onDelete: Restrict)
  createdByUser               User                       @relation("PatientFollowupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activityProgress            PatientFollowupActivityProgress[]

  @@unique([patientHospitalRelationshipId, roundNumber])
  @@index([patientHospitalRelationshipId, recordedAt])
  @@index([appointmentId])
  @@index([sourceGoalPlanId])
}

model PatientBaseline {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @unique @db.Uuid
  recordedOn                    DateTime @db.Date
  recordedByUserId              String   @db.Uuid
  weight                        Float?
  waistCircumference            Float?
  bloodPressureSystolic         Float?
  bloodPressureDiastolic        Float?
  bloodSugarDtx                 Float?
  adaptationSummary             String?  @db.VarChar(2000)
  adaptationObstacles           String?  @db.VarChar(2000)
  adaptationOpportunities       String?  @db.VarChar(2000)
  confidenceScore               Int?
  confidenceImprovementPlan     String?  @db.VarChar(2000)
  summary                       String?  @db.VarChar(2000)
  recommendations               String?  @db.VarChar(2000)
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  recordedBy                  User                        @relation("PatientBaselineRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  programsUsingAsInitial PatientProgram[] @relation("PatientProgramInitialBaseline")

  @@unique([id, patientHospitalRelationshipId])
}

model PatientProgram {
  id                            String               @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String               @db.Uuid
  initialBaselineId             String?              @db.Uuid
  createdByUserId               String               @db.Uuid
  status                        PatientProgramStatus @default(ACTIVE)
  startedAt                     DateTime             @default(now()) @db.Timestamptz(3)
  completedAt                   DateTime?            @db.Timestamptz(3)
  createdAt                     DateTime             @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  initialBaseline             PatientBaseline?            @relation("PatientProgramInitialBaseline", fields: [initialBaselineId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  createdByUser               User                        @relation("PatientProgramCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  serviceOneRoutine           PatientProgramServiceOneRoutine?
  serviceOneFloatingChart     PatientProgramServiceOneFloatingChart?
  serviceOneDreamCard         PatientProgramServiceOneDreamCard?
  serviceOneConfidence        PatientProgramServiceOneConfidence?

  @@index([patientHospitalRelationshipId, status])
  @@index([patientHospitalRelationshipId, startedAt])
  @@index([initialBaselineId])
}

model PatientProgramServiceOneRoutine {
  id               String   @id @default(uuid()) @db.Uuid
  patientProgramId String   @unique @db.Uuid
  recordedByUserId String   @db.Uuid
  recordedAt       DateTime @default(now()) @db.Timestamptz(3)

  patientProgram PatientProgram @relation(fields: [patientProgramId], references: [id], onDelete: Restrict)
  recordedByUser  User           @relation("PatientProgramServiceOneRoutineRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([recordedByUserId, recordedAt])
}

model PatientProgramServiceOneFloatingChart {
  id               String   @id @default(uuid()) @db.Uuid
  patientProgramId String   @unique @db.Uuid
  recordedByUserId String   @db.Uuid
  recordedAt       DateTime @default(now()) @db.Timestamptz(3)
  summary          String?  @db.VarChar(2000)

  patientProgram PatientProgram @relation(fields: [patientProgramId], references: [id], onDelete: Restrict)
  recordedByUser  User           @relation("PatientProgramServiceOneFloatingChartRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([recordedByUserId, recordedAt])
}

model PatientProgramServiceOneDreamCard {
  id               String   @id @default(uuid()) @db.Uuid
  patientProgramId String   @unique @db.Uuid
  recordedByUserId String   @db.Uuid
  recordedAt       DateTime @default(now()) @db.Timestamptz(3)
  description      String?  @db.VarChar(2000)

  patientProgram PatientProgram @relation(fields: [patientProgramId], references: [id], onDelete: Restrict)
  recordedByUser  User           @relation("PatientProgramServiceOneDreamCardRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([recordedByUserId, recordedAt])
}

model PatientProgramServiceOneConfidence {
  id               String   @id @default(uuid()) @db.Uuid
  patientProgramId String   @unique @db.Uuid
  recordedByUserId String   @db.Uuid
  recordedAt       DateTime @default(now()) @db.Timestamptz(3)
  score            Int
  improvementPlan  String?  @db.VarChar(2000)

  patientProgram PatientProgram @relation(fields: [patientProgramId], references: [id], onDelete: Restrict)
  recordedByUser  User           @relation("PatientProgramServiceOneConfidenceRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([recordedByUserId, recordedAt])
}

model PatientEvidenceArtifact {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  storageObjectKey              String   @unique @db.VarChar(512)
  mediaType                     String   @db.VarChar(100)
  byteSize                      Int
  contentSha256                 String   @db.VarChar(64)
  caption                       String?  @db.VarChar(500)
  createdByUserId               String   @db.Uuid
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  createdByUser               User                        @relation("PatientEvidenceArtifactCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([patientHospitalRelationshipId, createdAt])
}

model PatientFollowupActivityProgress {
  id          String                         @id @default(uuid()) @db.Uuid
  followupId  String                         @db.Uuid
  goalActivityCode String                    @db.VarChar(64)
  status      FollowupActivityProgressStatus
  note        String?                        @db.VarChar(1000)
  createdAt   DateTime                       @default(now()) @db.Timestamptz(3)

  followup PatientFollowup @relation(fields: [followupId], references: [id], onDelete: Restrict)

  @@unique([followupId, goalActivityCode])
  @@index([followupId, createdAt])
}

model PatientActivation {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  hospitalId      String   @db.Uuid
  tokenHash       String   @unique @db.VarChar(64)
  expiresAt       DateTime
  claimedAt       DateTime?
  claimExpiresAt  DateTime?
  reconciliationRequiredAt DateTime?
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User     @relation("PatientActivationTarget", fields: [userId], references: [id], onDelete: Cascade)
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("PatientActivationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([hospitalId])
  @@index([expiresAt])
  @@index([userId, reconciliationRequiredAt])
}

model OsmHospitalRelationship {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  hospitalId String           @db.Uuid
  status     MembershipStatus @default(PROVISIONED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User     @relation("OsmHospitalRelationships", fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation("OsmHospitalRelationships", fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([userId, hospitalId])
  @@index([hospitalId, status])
  @@index([userId, status])
}

model WorkforceActivation {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @db.Uuid
  tokenHash       String                  @unique @db.VarChar(64)
  mode            WorkforceActivationMode @default(REMOTE)
  expiresAt       DateTime
  claimedAt       DateTime?
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String                  @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user          User @relation("WorkforceActivationTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User @relation("WorkforceActivationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model HospitalOnboardingApplication {
  id              String                              @id @default(uuid()) @db.Uuid
  hospitalId      String                              @db.Uuid
  applicantUserId String                              @db.Uuid
  status          HospitalOnboardingApplicationStatus @default(PENDING)
  createdAt       DateTime                            @default(now())
  reviewedAt      DateTime?
  reviewedByUserId String?                            @db.Uuid
  rejectionReason String?                             @db.VarChar(500)
  updatedAt       DateTime                            @updatedAt

  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  applicantUser User     @relation("HospitalOnboardingApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewedByUser User?   @relation("HospitalOnboardingReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([hospitalId, status])
  @@index([applicantUserId, status])
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @db.VarChar(120)
  resourceId   String?  @db.VarChar(255)
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}
