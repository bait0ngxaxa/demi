model PatientFollowup {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  patientProgramId              String?  @db.Uuid
  appointmentId                String?  @db.Uuid
  sourceGoalPlanId              String?  @db.Uuid
  createdByUserId               String   @db.Uuid
  roundNumber                  Int
  submissionNonce              String   @unique @db.Uuid
  submissionRequestHash        String   @db.VarChar(64)
  recordedAt                   DateTime @default(now()) @db.Timestamptz(3)
  // Workbook DoD BR-01/06/07: nullable only for records created before these facts were captured.
  serviceDate                  DateTime? @db.Date
  planAdjusted                 Boolean?
  hasObstacle                  Boolean?
  obstacleNote                 String?  @db.VarChar(1000)
  weight                       Float?
  waistCircumference           Float?
  systolicBloodPressure        Float?
  diastolicBloodPressure       Float?
  bloodSugar                   Float?
  // R2-D: optional in rounds 3-6; the round falls back to the latest recorded height.
  heightCm                     Float?
  confidenceScore              Int?
  // R2-F: shown as "เกิดอะไรขึ้นบ้าง?" in Program Follow-ups.
  reflectionNote               String?  @db.VarChar(2000)
  // R2-F: ทำตามแผนได้ / ทำตามแผนไม่ได้; null for Follow-ups recorded before R2 (D5 still applies to those).
  followedPlan                 Boolean?
  expertAdvice                 String?  @db.VarChar(1000)
  confidencePlan               String?  @db.VarChar(2000)
  generalNote                  String?  @db.VarChar(2000)
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  patientProgram              PatientProgram?             @relation("PatientProgramFollowups", fields: [patientProgramId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  appointment                 PatientAppointment?         @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  sourceGoalPlan              PatientGoalPlan?            @relation("PatientFollowupSourceGoalPlan", fields: [sourceGoalPlanId], references: [id], onDelete: Restrict)
  sourceGoalPlanProgramScoped PatientGoalPlan?            @relation("PatientFollowupSourceGoalPlanProgramScoped", fields: [sourceGoalPlanId, patientProgramId, patientHospitalRelationshipId], references: [id, patientProgramId, patientHospitalRelationshipId], onDelete: Restrict)
  createdByUser               User                       @relation("PatientFollowupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activityProgress            PatientFollowupActivityProgress[]
  adjustedGoalPlans           PatientGoalPlan[]          @relation("PatientGoalPlanSourceFollowup")

  // This composite identity is the target of the adjusted Goal Plan -> Follow-up FK.
  @@unique([id, patientProgramId, patientHospitalRelationshipId])
  // The nullable historical namespace is guarded by a partial SQL index in the migration.
  @@unique([patientProgramId, roundNumber])
  @@index([patientHospitalRelationshipId, recordedAt])
  @@index([patientProgramId, recordedAt])
  @@index([appointmentId])
  @@index([sourceGoalPlanId])
}

