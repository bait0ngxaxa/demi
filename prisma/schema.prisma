  offering     HospitalServiceOffering      @relation(fields: [offeringId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  requestedBy  User                         @relation("PatientServiceRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  preferredOsm User?                        @relation("PatientServiceRequestPreferredOsm", fields: [preferredOsmUserId], references: [id], onDelete: SetNull)
  reviewedBy   User?                        @relation("PatientServiceRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  startedBy    User?                        @relation("PatientServiceRequestStarter", fields: [startedByUserId], references: [id], onDelete: SetNull)
  withdrawnBy  User?                        @relation("PatientServiceRequestWithdrawer", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)

  @@index([patientHospitalRelationshipId, createdAt])
  @@index([hospitalId, status, createdAt])
  @@index([offeringId])
  @@index([requestedByUserId, createdAt])
}

model PatientAccessRequest {
  id                  String                         @id @default(uuid()) @db.Uuid
  hospitalId          String                         @db.Uuid
  identityKeyHash     String                         @db.VarChar(64)
  status              PatientAccessRequestStatus     @default(PENDING)
  resolution          PatientAccessRequestResolution?
  reviewedByUserId    String?                        @db.Uuid
  reviewedAt          DateTime?
  resolvedPersonId    String?                        @db.Uuid
  resolvedUserId      String?                        @db.Uuid
  resolvedRelationshipId String?                     @db.Uuid
  completedAt         DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  hospital            Hospital                     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  reviewedBy          User?                        @relation("PatientAccessRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  resolvedPerson      Person?                      @relation("PatientAccessRequestResolvedPerson", fields: [resolvedPersonId], references: [id], onDelete: SetNull)
  resolvedUser        User?                        @relation("PatientAccessRequestResolvedUser", fields: [resolvedUserId], references: [id], onDelete: SetNull)
  resolvedRelationship PatientHospitalRelationship? @relation("PatientAccessRequestResolvedRelationship", fields: [resolvedRelationshipId], references: [id], onDelete: SetNull)
  patientActivation   PatientActivation?            @relation("PatientActivationAccessRequest")

  @@index([hospitalId, status, createdAt])
  @@index([identityKeyHash])
}

model PatientActivation {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  hospitalId      String   @db.Uuid
  patientAccessRequestId String? @unique @db.Uuid
  tokenHash       String   @unique @db.VarChar(64)
  expiresAt       DateTime
  claimedAt       DateTime?
  claimExpiresAt  DateTime?
  reconciliationRequiredAt DateTime?
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User     @relation("PatientActivationTarget", fields: [userId], references: [id], onDelete: Cascade)
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientAccessRequest PatientAccessRequest? @relation("PatientActivationAccessRequest", fields: [patientAccessRequestId], references: [id], onDelete: SetNull)
  createdByUser User     @relation("PatientActivationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([hospitalId])
  @@index([expiresAt])
  @@index([userId, reconciliationRequiredAt])
}

model OsmHospitalRelationship {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  hospitalId String           @db.Uuid
  status     MembershipStatus @default(PROVISIONED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User     @relation("OsmHospitalRelationships", fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation("OsmHospitalRelationships", fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([userId, hospitalId])
  @@index([hospitalId, status])
  @@index([userId, status])
}

model WorkforceActivation {
  id              String                  @id @default(uuid()) @db.Uuid
  userId          String                  @db.Uuid
  tokenHash       String                  @unique @db.VarChar(64)
  mode            WorkforceActivationMode @default(REMOTE)
  expiresAt       DateTime
  claimedAt       DateTime?
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String                  @db.Uuid
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  user          User @relation("WorkforceActivationTarget", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User @relation("WorkforceActivationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model HospitalOnboardingApplication {
  id              String                              @id @default(uuid()) @db.Uuid
  hospitalId      String                              @db.Uuid
  applicantUserId String                              @db.Uuid
  status          HospitalOnboardingApplicationStatus @default(PENDING)
  createdAt       DateTime                            @default(now())
  reviewedAt      DateTime?
  reviewedByUserId String?                            @db.Uuid
  rejectionReason String?                             @db.VarChar(500)
  updatedAt       DateTime                            @updatedAt

  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)
  applicantUser User     @relation("HospitalOnboardingApplicant", fields: [applicantUserId], references: [id], onDelete: Restrict)
  reviewedByUser User?   @relation("HospitalOnboardingReviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([hospitalId, status])
  @@index([applicantUserId, status])
}

model AuditEvent {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @db.Uuid
  action       String   @db.VarChar(120)
  resourceType String   @db.VarChar(120)
  resourceId   String?  @db.VarChar(255)
  metadata     Json?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  lineRecoveryDecisions LineAuthorizationLifecycle[]

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId, createdAt])
}

model LineAppointmentNotificationPreference {
  userId                    String   @id @db.Uuid
  bindingId                 String   @unique @db.Uuid
  bindingLifecycleVersion   Int
  preferenceVersion         Int      @default(1)
  enabled                   Boolean  @default(false)
  changedAt                 DateTime @db.Timestamptz(3)
  createdAt                 DateTime @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime @updatedAt @db.Timestamptz(3)

  user    User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  binding LineAccountBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
}

model AppointmentLineNotification {
  id                          String                                @id @default(uuid()) @db.Uuid
  appointmentId               String                                @db.Uuid
  patientHospitalRelationshipId String                              @db.Uuid
  sourceUpdatedAt              DateTime                              @db.Timestamptz(3)
  eventKind                    AppointmentLineNotificationEventKind
  recipientUserId              String?                               @db.Uuid
  bindingId                    String?                               @db.Uuid
  bindingLifecycleVersion      Int?
  preferenceVersion            Int?
  rolloutGeneration            String                                @db.Uuid
  state                        AppointmentLineNotificationState     @default(PENDING)
  dueAt                        DateTime                              @db.Timestamptz(3)
  attemptCount                 Int                                   @default(0)
  retryKey                     String                                @unique @default(uuid()) @db.Uuid
  leaseToken                   String?                               @unique @db.Uuid
  leaseExpiresAt               DateTime?                             @db.Timestamptz(3)
  firstAttemptAt               DateTime?                             @db.Timestamptz(3)
  lastAttemptAt                DateTime?                             @db.Timestamptz(3)
  safeOutcome                  AppointmentLineNotificationOutcome?
  terminalAt                   DateTime?                             @db.Timestamptz(3)
  createdAt                    DateTime                              @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime                              @updatedAt @db.Timestamptz(3)

  appointment               PatientAppointment         @relation(fields: [appointmentId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict, onUpdate: Restrict)
  recipient                 User?                      @relation("AppointmentLineNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)
  binding                   LineAccountBinding?        @relation(fields: [bindingId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, sourceUpdatedAt])
  @@index([state, dueAt])
  @@index([state, leaseExpiresAt])
  @@index([state, terminalAt])
}

model AppointmentLineNotificationWorkerState {
  id                Int      @id @default(1)
  lastInvocationAt  DateTime @default("1970-01-01T00:00:00.000Z") @db.Timestamptz(3)
}

model LineAccountBinding {
  id                              String                     @id @default(uuid()) @db.Uuid
  userId                          String                     @db.Uuid
  lineUserId                      String?                    @db.VarChar(64)
  lineSubjectFingerprint          String                     @db.VarChar(64)
  lineSubjectFingerprintKeyId     String                     @db.VarChar(64)
  linkedAt                        DateTime                   @default(now()) @db.Timestamptz(3)
  lastLinkedAt                    DateTime                   @default(now()) @db.Timestamptz(3)
  unlinkedAt                      DateTime?                  @db.Timestamptz(3)
  lifecycleVersion                Int                        @default(1)
  presentationRole               LineWorkspaceRole?
  presentationRoleSelectedAt      DateTime?                  @db.Timestamptz(3)
  reachability                    LineReachability           @default(UNKNOWN)
  reachabilityObservedAt          DateTime?                  @db.Timestamptz(3)
  menuExpectedKey                 String?                    @db.VarChar(100)
  menuSyncState                   LineMenuSyncState          @default(UNKNOWN)
  menuSyncedAt                    DateTime?                  @db.Timestamptz(3)
  providerCleanupState            LineProviderCleanupState?
  providerCleanupAttemptCount     Int                        @default(0)
  providerCleanupLastAttemptAt    DateTime?                  @db.Timestamptz(3)
  reconcileLeaseToken             String?                    @unique @db.Uuid
  reconcileLeaseExpiresAt         DateTime?                  @db.Timestamptz(3)
  createdAt                       DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt                       DateTime                   @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  authorizationLifecycles LineAuthorizationLifecycle[]
  recoveryIntents LineAccountActionIntent[]
  appointmentNotificationPreference LineAppointmentNotificationPreference?
  appointmentLineNotificationIntents AppointmentLineNotification[]

  @@index([userId])
  @@index([lineSubjectFingerprint])
  @@index([lineSubjectFingerprintKeyId])
  @@index([providerCleanupState, unlinkedAt])
}

model LineAccountActionIntent {
  id             String                    @id @default(uuid()) @db.Uuid
  userId         String                    @db.Uuid
  action         LineAccountAction
  challengeHash  String                    @db.VarChar(64)
  sessionHash    String                    @db.VarChar(64)
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime                  @db.Timestamptz(3)
  consumedAt     DateTime?                 @db.Timestamptz(3)
  outcome        LineAccountActionOutcome?
  targetBindingId String? @db.Uuid
  targetBindingVersion Int?
  reviewedSetDigest String? @db.VarChar(64)

  targetBinding LineAccountBinding? @relation(fields: [targetBindingId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([targetBindingId])
}

// External evidence only: these rows never confer application authority.
model LineAuthorizationLifecycle {
  id String @id @default(uuid()) @db.Uuid
  bindingId String @db.Uuid
  bindingVersion Int
  tupleKey String @db.VarChar(64)
  // Canonical immutable tuple definition; remains interpretable after config changes.
  tupleDefinition String @db.VarChar(512)
  applicability LineGrantApplicability
  evidenceReference String @db.VarChar(128)
  observedAt DateTime? @db.Timestamptz(3)
  remoteOutcome LineTerminationOutcome @default(OBSERVED)
  requestedAt DateTime? @db.Timestamptz(3)
  confirmedAt DateTime? @db.Timestamptz(3)
  reason LineTerminationReason?
  attemptId String? @unique @db.Uuid
  reservedAt DateTime? @db.Timestamptz(3)
  settledAt DateTime? @db.Timestamptz(3)
  recoveryReleasedAt DateTime? @db.Timestamptz(3)
  recoveryDecisionAuditId String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  binding LineAccountBinding @relation(fields: [bindingId], references: [id], onDelete: Restrict)
  recoveryDecision AuditEvent? @relation(fields: [recoveryDecisionAuditId], references: [id], onDelete: Restrict)

  @@unique([bindingId, bindingVersion, tupleKey], map: "LineAuthorizationLifecycle_binding_generation_tuple_key")
  @@index([recoveryDecisionAuditId])
}

model LineWebhookEventReceipt {
  webhookEventId String                    @id @db.VarChar(26)
  eventType      LineWebhookEventType
  eventOccurredAt DateTime                 @db.Timestamptz(3)
  acceptedAt     DateTime                  @default(now()) @db.Timestamptz(3)
  outcome        LineWebhookEventOutcome

  @@index([acceptedAt])
}
