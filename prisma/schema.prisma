  submissionNonce               String                              @unique @db.Uuid
  createdAt                     DateTime                            @default(now()) @db.Timestamptz(3)

  patientProgram PatientProgram @relation(fields: [patientProgramId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  recordedByUser User           @relation("PatientProgramRoundActivityRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([patientProgramId, roundNumber, toolCode])
  @@index([patientProgramId, roundNumber])
  @@index([recordedByUserId, performedAt])
}

