  contentSha256                 String   @db.VarChar(64)
  caption                       String?  @db.VarChar(500)
  createdByUserId               String   @db.Uuid
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  createdByUser               User                        @relation("PatientEvidenceArtifactCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  serviceOneArtifactAssociation PatientProgramServiceOneArtifactAssociation?

  @@index([patientHospitalRelationshipId, createdAt])
  @@unique([id, patientHospitalRelationshipId])
}

model PatientProgramServiceOneArtifactAssociation {
  id                            String   @id @default(uuid()) @db.Uuid
  patientProgramId             String   @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  patientEvidenceArtifactId     String   @db.Uuid
  routineId                     String?  @db.Uuid
  floatingChartId               String?  @db.Uuid
  dreamCardId                   String?  @db.Uuid
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)

  patientProgram         PatientProgram                         @relation(fields: [patientProgramId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  patientEvidenceArtifact PatientEvidenceArtifact                 @relation(fields: [patientEvidenceArtifactId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  routine                PatientProgramServiceOneRoutine?        @relation("PatientProgramServiceOneRoutineArtifact", fields: [routineId, patientProgramId], references: [id, patientProgramId], onDelete: Restrict)
  floatingChart          PatientProgramServiceOneFloatingChart?  @relation("PatientProgramServiceOneFloatingChartArtifact", fields: [floatingChartId, patientProgramId], references: [id, patientProgramId], onDelete: Restrict)
  dreamCard             PatientProgramServiceOneDreamCard?       @relation("PatientProgramServiceOneDreamCardArtifact", fields: [dreamCardId, patientProgramId], references: [id, patientProgramId], onDelete: Restrict)

  @@unique([routineId, patientProgramId])
  @@unique([floatingChartId, patientProgramId])
  @@unique([dreamCardId, patientProgramId])
  @@unique([patientEvidenceArtifactId, patientHospitalRelationshipId])
  @@index([patientProgramId, createdAt])
  @@index([patientHospitalRelationshipId, createdAt])
}

model PatientFollowupActivityProgress {
  id          String                         @id @default(uuid()) @db.Uuid
  followupId  String                         @db.Uuid
  goalActivityCode String                    @db.VarChar(64)
  status      FollowupActivityProgressStatus
  note        String?                        @db.VarChar(1000)
  createdAt   DateTime                       @default(now()) @db.Timestamptz(3)

  followup PatientFollowup @relation(fields: [followupId], references: [id], onDelete: Restrict)

  @@unique([followupId, goalActivityCode])
  @@index([followupId, createdAt])
}

model HospitalServiceOffering {
  id              String            @id @default(uuid()) @db.Uuid
  hospitalId      String            @db.Uuid
  code            PatientServiceCode
  enabled         Boolean           @default(false)
  createdByUserId String            @db.Uuid
  updatedByUserId String            @db.Uuid
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("HospitalServiceOfferingCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  updatedByUser User     @relation("HospitalServiceOfferingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)
  requests      PatientServiceRequest[]

  @@unique([hospitalId, code])
  @@unique([id, hospitalId])
  @@index([hospitalId, enabled])
}

model PatientServiceRequest {
  id                            String                     @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String                     @db.Uuid
  hospitalId                    String                     @db.Uuid
  offeringId                    String                     @db.Uuid
  requestedByUserId              String                     @db.Uuid
  preferredOsmUserId             String?                    @db.Uuid
  status                         PatientServiceRequestStatus @default(PENDING)
  reviewedByUserId               String?                    @db.Uuid
  reviewedAt                     DateTime?
  startedByUserId                String?                    @db.Uuid
  startedAt                      DateTime?
  withdrawnByUserId              String?                    @db.Uuid
  withdrawnAt                    DateTime?
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt

  relationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId, hospitalId], references: [id, hospitalId], onDelete: Cascade)
  offering     HospitalServiceOffering      @relation(fields: [offeringId, hospitalId], references: [id, hospitalId], onDelete: Restrict)
  requestedBy  User                         @relation("PatientServiceRequestRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  preferredOsm User?                        @relation("PatientServiceRequestPreferredOsm", fields: [preferredOsmUserId], references: [id], onDelete: SetNull)
  reviewedBy   User?                        @relation("PatientServiceRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  startedBy    User?                        @relation("PatientServiceRequestStarter", fields: [startedByUserId], references: [id], onDelete: SetNull)
  withdrawnBy  User?                        @relation("PatientServiceRequestWithdrawer", fields: [withdrawnByUserId], references: [id], onDelete: SetNull)

  @@index([patientHospitalRelationshipId, createdAt])
  @@index([hospitalId, status, createdAt])
  @@index([offeringId])
  @@index([requestedByUserId, createdAt])
}

model PatientAccessRequest {
  id                  String                         @id @default(uuid()) @db.Uuid
  hospitalId          String                         @db.Uuid
  identityKeyHash     String                         @db.VarChar(64)
  status              PatientAccessRequestStatus     @default(PENDING)
  resolution          PatientAccessRequestResolution?
  reviewedByUserId    String?                        @db.Uuid
  reviewedAt          DateTime?
  resolvedPersonId    String?                        @db.Uuid
  resolvedUserId      String?                        @db.Uuid
  resolvedRelationshipId String?                     @db.Uuid
  completedAt         DateTime?
  createdAt           DateTime                       @default(now())
  updatedAt           DateTime                       @updatedAt

  hospital            Hospital                     @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  reviewedBy          User?                        @relation("PatientAccessRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  resolvedPerson      Person?                      @relation("PatientAccessRequestResolvedPerson", fields: [resolvedPersonId], references: [id], onDelete: SetNull)
  resolvedUser        User?                        @relation("PatientAccessRequestResolvedUser", fields: [resolvedUserId], references: [id], onDelete: SetNull)
  resolvedRelationship PatientHospitalRelationship? @relation("PatientAccessRequestResolvedRelationship", fields: [resolvedRelationshipId], references: [id], onDelete: SetNull)
  patientActivation   PatientActivation?            @relation("PatientActivationAccessRequest")

  @@index([hospitalId, status, createdAt])
  @@index([identityKeyHash])
}

model PatientActivation {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  hospitalId      String   @db.Uuid
  patientAccessRequestId String? @unique @db.Uuid
  tokenHash       String   @unique @db.VarChar(64)
  expiresAt       DateTime
  claimedAt       DateTime?
  claimExpiresAt  DateTime?
  reconciliationRequiredAt DateTime?
  usedAt          DateTime?
  revokedAt       DateTime?
  createdByUserId String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User     @relation("PatientActivationTarget", fields: [userId], references: [id], onDelete: Cascade)
  hospital      Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  patientAccessRequest PatientAccessRequest? @relation("PatientActivationAccessRequest", fields: [patientAccessRequestId], references: [id], onDelete: SetNull)
  createdByUser User     @relation("PatientActivationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([hospitalId])
  @@index([expiresAt])
  @@index([userId, reconciliationRequiredAt])
}

model OsmHospitalRelationship {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  hospitalId String           @db.Uuid
  status     MembershipStatus @default(PROVISIONED)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user     User     @relation("OsmHospitalRelationships", fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation("OsmHospitalRelationships", fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([userId, hospitalId])
  @@index([hospitalId, status])
  @@index([userId, status])
}

model WorkforceActivation {
