generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  HOSPITAL
  OSM
  PATIENT
}

enum UserStatus {
  PROVISIONED
  INVITED
  ACTIVE
  SUSPENDED
}

enum AccountRecoveryDeliveryChannel {
  ASSISTED
}

enum HospitalStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum HospitalOnboardingApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MembershipType {
  OWNER
  MEMBER
}

enum Profession {
  DOCTOR
  NURSE
  COORDINATOR
  OTHER
}

enum MembershipStatus {
  PROVISIONED
  INVITED
  ACTIVE
  SUSPENDED
}

enum PatientClassificationType {
  RISK
  DIABETES
}

enum PatientClassificationSource {
  ROSTER_IMPORT
  MANUAL
}

enum WorkforceActivationMode {
  REMOTE
  ASSISTED
}

enum AppointmentType {
  FOLLOW_UP
  CONSULTATION
}

enum AppointmentLocationType {
  CLINIC
  ONLINE
  HOME_VISIT
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentInteractionSource {
  PATIENT_SELF
  OSM_PROXY
}

enum AppointmentCancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  SUPERSEDED
}

enum FollowupActivityProgressStatus {
  DONE
  PARTIAL
  NOT_DONE
  NOT_APPLICABLE
}

enum PatientProgramStatus {
  ACTIVE
  COMPLETED
}

enum PatientServiceCode {
  SCREENING
  FOLLOW_UP
  EMPOWERMENT
}

enum PatientServiceRequestStatus {
  PENDING
  APPROVED
  REJECTED
  STARTED
  WITHDRAWN
}

enum PatientAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
  ACTIVATION_ISSUED
  COMPLETED
}

enum PatientAccessRequestResolution {
  ACTIVATION_COMPLETED
  ALREADY_ACTIVE
}

enum CaregiverInvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

enum CaregiverRelationshipStatus {
  ACTIVE
  REVOKED
  WITHDRAWN
}

model Person {
  id              String   @id @default(uuid()) @db.Uuid
  identityKeyHash String   @unique @db.VarChar(64)
  givenName       String?  @db.VarChar(120)
  familyName      String?  @db.VarChar(120)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User?
  patientProfile PatientProfile?
  patientAccessRequestsResolved PatientAccessRequest[] @relation("PatientAccessRequestResolvedPerson")

  @@index([familyName, givenName])
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  personId    String     @unique @db.Uuid
  authSubject String?    @unique @db.VarChar(255)
  status      UserStatus @default(PROVISIONED)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  person      Person               @relation(fields: [personId], references: [id], onDelete: Restrict)
  roles       UserRole[]
  memberships HospitalMembership[]
  osmHospitalRelationships OsmHospitalRelationship[] @relation("OsmHospitalRelationships")
  workforceActivations WorkforceActivation[] @relation("WorkforceActivationTarget")
  workforceActivationsCreated WorkforceActivation[] @relation("WorkforceActivationCreator")
  patientActivations PatientActivation[] @relation("PatientActivationTarget")
  patientActivationsCreated PatientActivation[] @relation("PatientActivationCreator")
  accountRecoveries AccountRecovery[] @relation("AccountRecoveryTarget")
  accountRecoveriesIssued AccountRecovery[] @relation("AccountRecoveryIssuer")
  caregiverInvitationsReceived CaregiverInvitation[] @relation("CaregiverInvitationCaregiver")
  caregiverInvitationsIssued CaregiverInvitation[] @relation("CaregiverInvitationIssuer")
  caregiverInvitationsRevoked CaregiverInvitation[] @relation("CaregiverInvitationRevoker")
  caregiverRelationships CaregiverRelationship[] @relation("CaregiverRelationshipCaregiver")
  caregiverRelationshipsRevoked CaregiverRelationship[] @relation("CaregiverRelationshipRevoker")
  patientOsmAssignments PatientOsmAssignment[] @relation("PatientOsmAssignments")
  patientOsmAssignmentsCreated PatientOsmAssignment[] @relation("PatientOsmAssignmentsCreated")
  patientOsmAssignmentsEnded PatientOsmAssignment[] @relation("PatientOsmAssignmentsEnded")
  screeningAssessmentsConducted ScreeningAssessment[] @relation("ScreeningAssessmentConductedBy")
  goalPlansCreated PatientGoalPlan[] @relation("PatientGoalPlanCreatedBy")
  appointmentsResponsible PatientAppointment[] @relation("PatientAppointmentResponsible")
  appointmentsCreated PatientAppointment[] @relation("PatientAppointmentCreatedBy")
  appointmentAcknowledgementsRecorded PatientAppointmentAcknowledgement[] @relation("AppointmentAcknowledgementRecordedBy")
  appointmentCancellationRequestsSubmitted PatientAppointmentCancellationRequest[] @relation("AppointmentCancellationRequestSubmittedBy")
  appointmentCancellationRequestsResolved PatientAppointmentCancellationRequest[] @relation("AppointmentCancellationRequestResolvedBy")
  appointmentCoordinationEventsRecorded PatientAppointmentCoordinationEvent[] @relation("AppointmentCoordinationEventRecordedBy")
  followupsCreated PatientFollowup[] @relation("PatientFollowupCreatedBy")
  patientProgramsCreated PatientProgram[] @relation("PatientProgramCreatedBy")
  patientBaselinesRecorded PatientBaseline[] @relation("PatientBaselineRecordedBy")
  patientClassificationsUpdated PatientClassification[] @relation("PatientClassificationUpdatedBy")
  patientClassificationHistoryChanged PatientClassificationHistory[] @relation("PatientClassificationHistoryChangedBy")
  patientServiceOfferingsCreated HospitalServiceOffering[] @relation("HospitalServiceOfferingCreatedBy")
  patientServiceOfferingsUpdated HospitalServiceOffering[] @relation("HospitalServiceOfferingUpdatedBy")
  patientServiceRequestsRequested PatientServiceRequest[] @relation("PatientServiceRequestRequester")
  patientServiceRequestsPreferredOsm PatientServiceRequest[] @relation("PatientServiceRequestPreferredOsm")
  patientServiceRequestsReviewed PatientServiceRequest[] @relation("PatientServiceRequestReviewer")
  patientServiceRequestsStarted PatientServiceRequest[] @relation("PatientServiceRequestStarter")
  patientServiceRequestsWithdrawn PatientServiceRequest[] @relation("PatientServiceRequestWithdrawer")
  patientAccessRequestsReviewed PatientAccessRequest[] @relation("PatientAccessRequestReviewer")
  patientAccessRequestsResolved PatientAccessRequest[] @relation("PatientAccessRequestResolvedUser")
  patientFinalAssessmentsRecorded PatientFinalAssessment[] @relation("PatientFinalAssessmentRecordedBy")
  patientEvidenceArtifactsCreated PatientEvidenceArtifact[] @relation("PatientEvidenceArtifactCreatedBy")
  patientProgramServiceOneRoutinesRecorded PatientProgramServiceOneRoutine[] @relation("PatientProgramServiceOneRoutineRecordedBy")
  patientProgramServiceOneFloatingChartsRecorded PatientProgramServiceOneFloatingChart[] @relation("PatientProgramServiceOneFloatingChartRecordedBy")
  patientProgramServiceOneDreamCardsRecorded PatientProgramServiceOneDreamCard[] @relation("PatientProgramServiceOneDreamCardRecordedBy")
  patientProgramServiceOneConfidencesRecorded PatientProgramServiceOneConfidence[] @relation("PatientProgramServiceOneConfidenceRecordedBy")
  auditEvents AuditEvent[]
  hospitalOnboardingApplications HospitalOnboardingApplication[] @relation("HospitalOnboardingApplicant")
  hospitalOnboardingReviews     HospitalOnboardingApplication[] @relation("HospitalOnboardingReviewer")

  // Supports a composite FK that keeps an invitation bound to this exact User + Person pair.
  @@unique([id, personId])
}

model UserRole {
  userId    String   @db.Uuid
  role      Role
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, role])
  @@index([role])
}

model Hospital {
  id              String         @id @default(uuid()) @db.Uuid
  hospitalCode    String         @unique @db.VarChar(32)
  name            String         @db.VarChar(200)
  status          HospitalStatus @default(PENDING_VERIFICATION)
  parentHospitalId String?       @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  memberships              HospitalMembership[]
  osmHospitalRelationships OsmHospitalRelationship[] @relation("OsmHospitalRelationships")
  patientRelationships     PatientHospitalRelationship[]
  patientActivations      PatientActivation[]
  onboardingApplications   HospitalOnboardingApplication[]
  serviceOfferings         HospitalServiceOffering[]
  patientAccessRequests    PatientAccessRequest[]
  parentHospital           Hospital? @relation("HospitalHierarchy", fields: [parentHospitalId], references: [id], onDelete: Restrict)
  childHospitals            Hospital[] @relation("HospitalHierarchy")

  @@index([status, name])
}

model HospitalMembership {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  hospitalId     String           @db.Uuid
  membershipType MembershipType
  profession     Profession?
  status         MembershipStatus @default(PROVISIONED)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([userId, hospitalId])
  @@index([hospitalId, status])
}

model PatientProfile {
  id                    String    @id @default(uuid()) @db.Uuid
  personId              String    @unique @db.Uuid
  dateOfBirth           DateTime? @db.Date
  gender                String?   @db.VarChar(64)
  phoneNumber           String?   @db.VarChar(32)
  addressText           String?   @db.VarChar(500)
  emergencyContactName  String?   @db.VarChar(200)
  emergencyContactPhone String?   @db.VarChar(32)
  occupation            String?   @db.VarChar(200)
  educationLevel        String?   @db.VarChar(200)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  person                Person                       @relation(fields: [personId], references: [id], onDelete: Restrict)
  hospitalRelationships PatientHospitalRelationship[]
  caregiverInvitations CaregiverInvitation[]
  caregiverRelationships CaregiverRelationship[]
  patientClassification PatientClassification?
  classificationHistory PatientClassificationHistory[]
}

model PatientClassification {
  id               String                    @id @default(uuid()) @db.Uuid
  patientProfileId String                    @unique @db.Uuid
  classification   PatientClassificationType
  updatedByUserId  String                    @db.Uuid
  createdAt        DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  updatedByUser  User           @relation("PatientClassificationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([classification])
  @@index([updatedByUserId, updatedAt])
}

model PatientClassificationHistory {
  id                 String                    @id @default(uuid()) @db.Uuid
  patientProfileId   String                    @db.Uuid
  fromClassification PatientClassificationType?
  toClassification   PatientClassificationType
  changedAt          DateTime                  @default(now()) @db.Timestamptz(3)
  changedByUserId    String                    @db.Uuid
  source             PatientClassificationSource

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  changedByUser  User           @relation("PatientClassificationHistoryChangedBy", fields: [changedByUserId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, changedAt])
  @@index([changedByUserId, changedAt])
}

model PatientHospitalRelationship {
  id               String   @id @default(uuid()) @db.Uuid
  patientProfileId String   @db.Uuid
  hospitalId       String   @db.Uuid
  hospitalNumber   String?  @db.VarChar(64)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  hospital       Hospital       @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  hospitalProfile PatientHospitalProfile?
  accountRecoveries AccountRecovery[]
  osmAssignments PatientOsmAssignment[]
  screeningAssessments ScreeningAssessment[]
  goalPlans PatientGoalPlan[]
  appointments PatientAppointment[]
  followups PatientFollowup[]
  programs PatientProgram[]
  finalAssessments PatientFinalAssessment[]
  baseline             PatientBaseline?
  evidenceArtifacts    PatientEvidenceArtifact[]
  serviceRequests      PatientServiceRequest[]
  patientAccessRequestsResolved PatientAccessRequest[] @relation("PatientAccessRequestResolvedRelationship")

  @@unique([patientProfileId, hospitalId])
  @@unique([id, hospitalId])
  @@index([hospitalId])
  @@index([hospitalId, hospitalNumber])
}

model PatientHospitalProfile {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @unique @db.Uuid
  gender                        String?  @db.VarChar(64)
  phoneNumber                   String?  @db.VarChar(32)
  addressText                   String?  @db.VarChar(500)
  emergencyContactName          String?  @db.VarChar(200)
  emergencyContactPhone         String?  @db.VarChar(32)
  occupation                    String?  @db.VarChar(200)
  educationLevel                String?  @db.VarChar(200)
  version                       Int      @default(1)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  relationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Cascade)
}

model CaregiverInvitation {
  id                         String                    @id @default(uuid()) @db.Uuid
  patientProfileId           String                    @db.Uuid
  caregiverUserId            String                    @db.Uuid
  caregiverPersonId          String                    @db.Uuid
  issuedByUserId              String                    @db.Uuid
  tokenHash                   String                    @unique @db.VarChar(64)
  status                      CaregiverInvitationStatus @default(PENDING)
  acceptanceContractVersion   String?                   @db.VarChar(64)
  issuedAt                    DateTime                  @default(now()) @db.Timestamptz(3)
  expiresAt                   DateTime                  @db.Timestamptz(3)
  acceptedAt                  DateTime?                 @db.Timestamptz(3)
  rejectedAt                  DateTime?                 @db.Timestamptz(3)
  revokedAt                   DateTime?                 @db.Timestamptz(3)
  expiredAt                   DateTime?                 @db.Timestamptz(3)
  createdAt                   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                  @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  caregiverUser User @relation("CaregiverInvitationCaregiver", fields: [caregiverUserId, caregiverPersonId], references: [id, personId], onDelete: Restrict, onUpdate: Restrict)
  issuedByUser User @relation("CaregiverInvitationIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("CaregiverInvitationRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)
  revokedByUserId String? @db.Uuid
  relationship CaregiverRelationship?

  @@index([patientProfileId, createdAt])
  @@index([caregiverUserId, createdAt])
  // Additional source-pair FK is enforced by the corrective SQL migration.
  @@unique([id, patientProfileId, caregiverUserId], map: "CaregiverInvitation_source_pair_key")
  @@index([status, expiresAt])
}

model CaregiverRelationship {
  id                String                       @id @default(uuid()) @db.Uuid
  patientProfileId  String                       @db.Uuid
  caregiverUserId   String                       @db.Uuid
  sourceInvitationId String                      @unique @db.Uuid
  status            CaregiverRelationshipStatus @default(ACTIVE)
  activatedAt       DateTime                     @db.Timestamptz(3)
  revokedAt         DateTime?                    @db.Timestamptz(3)
  revokedByUserId   String?                      @db.Uuid
  withdrawnAt       DateTime?                    @db.Timestamptz(3)
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Restrict)
  caregiverUser User @relation("CaregiverRelationshipCaregiver", fields: [caregiverUserId], references: [id], onDelete: Restrict)
  sourceInvitation CaregiverInvitation @relation(fields: [sourceInvitationId], references: [id], onDelete: Restrict)
  revokedByUser User? @relation("CaregiverRelationshipRevoker", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([patientProfileId, createdAt])
  @@index([caregiverUserId, createdAt])
}

model AccountRecovery {
  id                            String                         @id @default(uuid()) @db.Uuid
  targetUserId                  String                         @db.Uuid
  patientHospitalRelationshipId String                         @db.Uuid
  issuedByUserId                String                         @db.Uuid
  tokenHash                     String                         @unique @db.VarChar(64)
  deliveryChannel               AccountRecoveryDeliveryChannel @default(ASSISTED)
  expiresAt                     DateTime
  claimedAt                     DateTime?
  completedAt                   DateTime?
  reconciliationRequiredAt      DateTime?
  revokedAt                     DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt

  targetUser   User                        @relation("AccountRecoveryTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  relationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Cascade)
  issuedByUser User                        @relation("AccountRecoveryIssuer", fields: [issuedByUserId], references: [id], onDelete: Restrict)

  @@index([targetUserId, createdAt])
  @@index([expiresAt])
  @@index([patientHospitalRelationshipId, createdAt])
}

model PatientOsmAssignment {
  id                            String    @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String    @db.Uuid
  osmUserId                     String    @db.Uuid
  assignedByUserId              String    @db.Uuid
  createdAt                     DateTime  @default(now())
  endedAt                       DateTime?
  endedByUserId                 String?   @db.Uuid

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  osmUser                     User                       @relation("PatientOsmAssignments", fields: [osmUserId], references: [id], onDelete: Restrict)
  assignedByUser              User                       @relation("PatientOsmAssignmentsCreated", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  endedByUser                 User?                      @relation("PatientOsmAssignmentsEnded", fields: [endedByUserId], references: [id], onDelete: Restrict)
  appointmentsAtCreation      PatientAppointment[]       @relation("AppointmentOsmAssignmentAtCreation")

  @@index([patientHospitalRelationshipId, createdAt])
  @@index([osmUserId, endedAt])
}

model ScreeningAssessment {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  conductedByUserId             String   @db.Uuid
  submissionNonce               String   @unique @db.Uuid
  questionSetKey                String   @db.VarChar(64)
  questionSetVersion            String   @db.VarChar(64)
  scoringVersion                String   @db.VarChar(64)
  responses                     Json
  result                        Json
  submittedAt                   DateTime @default(now())
  createdAt                     DateTime @default(now())

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  conductedByUser             User                       @relation("ScreeningAssessmentConductedBy", fields: [conductedByUserId], references: [id], onDelete: Restrict)
  goalPlansSourced             PatientGoalPlan[]          @relation("GoalPlanSourceScreening")

  @@index([patientHospitalRelationshipId, submittedAt])
  @@index([conductedByUserId, submittedAt])
}

model PatientGoalPlan {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  patientProgramId              String?  @db.Uuid
  createdByUserId               String   @db.Uuid
  sourceScreeningAssessmentId   String?  @db.Uuid
  submissionNonce               String   @unique @db.Uuid
  templateKey                   String   @db.VarChar(64)
  templateVersion               String   @db.VarChar(64)
  roundNumber                   Int
  primaryGoalCode               String   @db.VarChar(64)
  primaryGoalNote               String?  @db.VarChar(1000)
  weeklyNote                    String?  @db.VarChar(2000)
  createdAt                     DateTime @default(now())

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  patientProgram              PatientProgram?             @relation("PatientProgramGoalPlans", fields: [patientProgramId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  createdByUser               User                       @relation("PatientGoalPlanCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  sourceScreeningAssessment   ScreeningAssessment?       @relation("GoalPlanSourceScreening", fields: [sourceScreeningAssessmentId], references: [id], onDelete: Restrict)
  items                       PatientGoalItem[]
  followupsSourced             PatientFollowup[]          @relation("PatientFollowupSourceGoalPlan")
  followupsSourcedProgramScoped PatientFollowup[]          @relation("PatientFollowupSourceGoalPlanProgramScoped")

  // This composite identity is the target of the linked Follow-up -> Goal Plan FK.
  @@unique([id, patientProgramId, patientHospitalRelationshipId])
  // The nullable historical namespace is guarded by a partial SQL index in the migration.
  @@unique([patientProgramId, roundNumber])
  @@index([patientHospitalRelationshipId, createdAt])
  @@index([patientProgramId, createdAt])
}

model PatientGoalItem {
  id          String   @id @default(uuid()) @db.Uuid
  goalPlanId  String   @db.Uuid
  activityCode String  @db.VarChar(64)
  targetDays  Int
  targetValue Float?
  targetUnit  String?  @db.VarChar(32)
  sortOrder   Int
  createdAt   DateTime @default(now())

  goalPlan PatientGoalPlan @relation(fields: [goalPlanId], references: [id], onDelete: Cascade)

  @@unique([goalPlanId, activityCode])
  @@index([goalPlanId, sortOrder])
}

model PatientAppointment {
  id                            String                  @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String                  @db.Uuid
  osmAssignmentIdAtCreation     String?                 @db.Uuid
  responsibleUserId            String?                 @db.Uuid
  createdByUserId               String                  @db.Uuid
  type                          AppointmentType
  scheduledAt                   DateTime                @db.Timestamptz(3)
  durationMinutes               Int?
  locationType                  AppointmentLocationType?
  locationDetail                String?                 @db.VarChar(500)
  note                          String?                 @db.VarChar(2000)
  status                        AppointmentStatus       @default(SCHEDULED)
  submissionNonce               String                  @unique @db.Uuid
  creationRequestHash           String?                 @db.VarChar(64)
  createdAt                     DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime                @updatedAt @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  responsibleUser             User?                      @relation("PatientAppointmentResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  createdByUser               User                       @relation("PatientAppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  osmAssignmentAtCreation     PatientOsmAssignment?      @relation("AppointmentOsmAssignmentAtCreation", fields: [osmAssignmentIdAtCreation], references: [id], onDelete: Restrict)
  acknowledgements            PatientAppointmentAcknowledgement[]
  cancellationRequests        PatientAppointmentCancellationRequest[]
  coordinationEvents          PatientAppointmentCoordinationEvent[]
  followups                   PatientFollowup[]

  @@index([patientHospitalRelationshipId, scheduledAt])
  @@index([responsibleUserId])
  @@index([status])
}

model PatientAppointmentAcknowledgement {
  id                         String                        @id @default(uuid()) @db.Uuid
  appointmentId              String                        @db.Uuid
  sourceAppointmentUpdatedAt  DateTime                      @db.Timestamptz(3)
  recordedByUserId            String                        @db.Uuid
  source                      AppointmentInteractionSource
  acknowledgedAt              DateTime                      @default(now()) @db.Timestamptz(3)

  appointment    PatientAppointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  recordedByUser User               @relation("AppointmentAcknowledgementRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, sourceAppointmentUpdatedAt])
  @@index([recordedByUserId, acknowledgedAt])
}

model PatientAppointmentCancellationRequest {
  id                         String                                @id @default(uuid()) @db.Uuid
  appointmentId              String                                @db.Uuid
  sourceAppointmentUpdatedAt  DateTime                              @db.Timestamptz(3)
  submittedByUserId           String                                @db.Uuid
  source                      AppointmentInteractionSource
  submissionNonce             String                                @unique @db.Uuid
  status                      AppointmentCancellationRequestStatus @default(PENDING)
  submittedAt                 DateTime                              @default(now()) @db.Timestamptz(3)
  resolvedByUserId            String?                               @db.Uuid
  resolvedAt                  DateTime?                             @db.Timestamptz(3)

  appointment     PatientAppointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  submittedByUser User               @relation("AppointmentCancellationRequestSubmittedBy", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  resolvedByUser  User?              @relation("AppointmentCancellationRequestResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)

  @@index([appointmentId, submittedAt])
  @@index([status, submittedAt])
  @@index([submittedByUserId, submittedAt])
}

model PatientAppointmentCoordinationEvent {
  id               String   @id @default(uuid()) @db.Uuid
  appointmentId    String   @db.Uuid
  recordedByUserId String   @db.Uuid
  submissionNonce  String   @unique @db.Uuid
  recordedAt       DateTime @default(now()) @db.Timestamptz(3)

  appointment    PatientAppointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  recordedByUser User               @relation("AppointmentCoordinationEventRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  @@index([appointmentId, recordedAt, id])
  @@index([recordedByUserId, recordedAt])
}

model PatientFollowup {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  patientProgramId              String?  @db.Uuid
  appointmentId                String?  @db.Uuid
  sourceGoalPlanId              String?  @db.Uuid
  createdByUserId               String   @db.Uuid
  roundNumber                  Int
  submissionNonce              String   @unique @db.Uuid
  submissionRequestHash        String   @db.VarChar(64)
  recordedAt                   DateTime @default(now()) @db.Timestamptz(3)
  weight                       Float?
  waistCircumference           Float?
  systolicBloodPressure        Float?
  diastolicBloodPressure       Float?
  bloodSugar                   Float?
  confidenceScore              Int?
  reflectionNote               String?  @db.VarChar(2000)
  confidencePlan               String?  @db.VarChar(2000)
  generalNote                  String?  @db.VarChar(2000)
  createdAt                    DateTime @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  patientProgram              PatientProgram?             @relation("PatientProgramFollowups", fields: [patientProgramId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  appointment                 PatientAppointment?         @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  sourceGoalPlan              PatientGoalPlan?            @relation("PatientFollowupSourceGoalPlan", fields: [sourceGoalPlanId], references: [id], onDelete: Restrict)
  sourceGoalPlanProgramScoped PatientGoalPlan?            @relation("PatientFollowupSourceGoalPlanProgramScoped", fields: [sourceGoalPlanId, patientProgramId, patientHospitalRelationshipId], references: [id, patientProgramId, patientHospitalRelationshipId], onDelete: Restrict)
  createdByUser               User                       @relation("PatientFollowupCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  activityProgress            PatientFollowupActivityProgress[]

  // The nullable historical namespace is guarded by a partial SQL index in the migration.
  @@unique([patientProgramId, roundNumber])
  @@index([patientHospitalRelationshipId, recordedAt])
  @@index([patientProgramId, recordedAt])
  @@index([appointmentId])
  @@index([sourceGoalPlanId])
}

model PatientBaseline {
  id                            String   @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String   @unique @db.Uuid
  recordedOn                    DateTime @db.Date
  recordedByUserId              String   @db.Uuid
  weight                        Float?
  heightCm                      Float?
  waistCircumference            Float?
  bloodPressureSystolic         Float?
  bloodPressureDiastolic        Float?
  bloodSugarDtx                 Float?
  hba1c                         Float?
  adaptationSummary             String?  @db.VarChar(2000)
  adaptationObstacles           String?  @db.VarChar(2000)
  adaptationOpportunities       String?  @db.VarChar(2000)
  confidenceScore               Int?
  confidenceImprovementPlan     String?  @db.VarChar(2000)
  summary                       String?  @db.VarChar(2000)
  recommendations               String?  @db.VarChar(2000)
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  recordedBy                  User                        @relation("PatientBaselineRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  programsUsingAsInitial PatientProgram[] @relation("PatientProgramInitialBaseline")

  @@unique([id, patientHospitalRelationshipId])
}

model PatientProgram {
  id                            String               @id @default(uuid()) @db.Uuid
  patientHospitalRelationshipId String               @db.Uuid
  initialBaselineId             String?              @db.Uuid
  createdByUserId               String               @db.Uuid
  status                        PatientProgramStatus @default(ACTIVE)
  startedAt                     DateTime             @default(now()) @db.Timestamptz(3)
  completedAt                   DateTime?            @db.Timestamptz(3)
  createdAt                     DateTime             @default(now()) @db.Timestamptz(3)

  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  initialBaseline             PatientBaseline?            @relation("PatientProgramInitialBaseline", fields: [initialBaselineId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  createdByUser               User                        @relation("PatientProgramCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  goalPlans                    PatientGoalPlan[]           @relation("PatientProgramGoalPlans")
  followups                    PatientFollowup[]           @relation("PatientProgramFollowups")
  finalAssessment              PatientFinalAssessment?
  serviceOneRoutine           PatientProgramServiceOneRoutine?
  serviceOneFloatingChart     PatientProgramServiceOneFloatingChart?
  serviceOneDreamCard         PatientProgramServiceOneDreamCard?
  serviceOneConfidence        PatientProgramServiceOneConfidence?
  serviceOneArtifactAssociations PatientProgramServiceOneArtifactAssociation[]

  @@index([patientHospitalRelationshipId, status])
  @@index([patientHospitalRelationshipId, startedAt])
  @@index([initialBaselineId])
  @@unique([id, patientHospitalRelationshipId])
}

model PatientFinalAssessment {
  id                            String   @id @default(uuid()) @db.Uuid
  patientProgramId              String   @unique @db.Uuid
  patientHospitalRelationshipId String   @db.Uuid
  recordedByUserId              String   @db.Uuid
  weight                        Float?
  waistCircumference            Float?
  systolicBloodPressure         Float?
  diastolicBloodPressure        Float?
  bloodSugar                    Float?
  recordedAt                    DateTime @default(now()) @db.Timestamptz(3)
  createdAt                     DateTime @default(now()) @db.Timestamptz(3)

  patientProgram              PatientProgram              @relation(fields: [patientProgramId, patientHospitalRelationshipId], references: [id, patientHospitalRelationshipId], onDelete: Restrict)
  patientHospitalRelationship PatientHospitalRelationship @relation(fields: [patientHospitalRelationshipId], references: [id], onDelete: Restrict)
  recordedBy                  User                        @relation("PatientFinalAssessmentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)

  // Prisma requires the exact composite relation fields to be unique; the
  // single-column unique field above is the Program cardinality backstop.
  @@unique([patientProgramId, patientHospitalRelationshipId])
  @@index([recordedByUserId, recordedAt])
}

model PatientProgramServiceOneRoutine {
  id               String   @id @default(uuid()) @db.Uuid
  patientProgramId String   @unique @db.Uuid
  recordedByUserId String   @db.Uuid
