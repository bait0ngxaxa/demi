// UM-1 (UM-D5): an OWNER reported that an account is not used by its real owner. The User is SUSPENDED in the same
// transaction (every access path requires ACTIVE); this row records the provider session revocation outcome. Terminal:
// only a platform ADMIN or a future Phase I recovery path resolves it.
model UserTakeoverLock {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String                    @unique @db.Uuid
  hospitalId        String                    @db.Uuid
  lockedByUserId    String                    @db.Uuid
  lockedAt          DateTime                  @db.Timestamptz(3)
  providerState     UserTakeoverProviderState @default(PENDING)
  providerCheckedAt DateTime?                 @db.Timestamptz(3)
  suspendedMembershipIds String[]              @default([]) @db.Uuid
  suspendedOsmRelationshipIds String[]         @default([]) @db.Uuid
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)

  user     User     @relation("UserTakeoverLockTarget", fields: [userId], references: [id], onDelete: Restrict)
  lockedBy User     @relation("UserTakeoverLockActor", fields: [lockedByUserId], references: [id], onDelete: Restrict)
  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Restrict)

  @@index([hospitalId, lockedAt])
  @@index([lockedByUserId])
}

