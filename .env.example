NODE_ENV=development
# Server-only operational opt-in for synthetic/demo delegated appointment reads.
# Absence/false/invalid values deny. Enabling is NOT controller/privacy approval for real data.
FAMILY_DELEGATED_APPOINTMENT_READ_ENABLED=false
# Optional local/test-only escape hatch for checksum-invalid 13-digit demo IDs.
# Keep this unset or false in production; category and format checks still apply.
DEMI_ALLOW_TEST_NATIONAL_IDS=false
# Use the same Supabase development project for both database and Auth/API values.
DATABASE_URL=postgresql://postgres:your-development-db-password@db.your-development-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-development-db-password@db.your-development-project-ref.supabase.co:5432/postgres
IDENTITY_HASH_SECRET=replace-with-a-random-server-secret-at-least-32-characters
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
SUPABASE_PATIENT_EVIDENCE_BUCKET=patient-evidence
# DEMI LINE Login / LIFF configuration. Keep server credentials server-only.
DEMI_LINE_LOGIN_CHANNEL_ID=your-demi-line-login-channel-id
NEXT_PUBLIC_DEMI_LINE_LIFF_ID=your-demi-liff-id
DEMI_LINE_PUBLIC_ORIGIN=https://demi.example.org
# DEMI LINE Messaging API channel; do not reuse credentials from another provider.
DEMI_LINE_MESSAGING_CHANNEL_SECRET=your-demi-line-messaging-channel-secret
DEMI_LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your-demi-line-messaging-channel-access-token
DEMI_LINE_MESSAGING_BOT_USER_ID=U00000000000000000000000000000000
