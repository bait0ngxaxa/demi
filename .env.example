NODE_ENV=development
# Application deployment stage. Allowed values: development, uat, production.
DEMI_DEPLOYMENT_STAGE=development
# Server-only HMAC key for signed reporting pagination cursors (at least 32 random bytes).
DEMI_HOSPITAL_REPORTING_CURSOR_SECRET=
# Server-only operational opt-in for synthetic/demo delegated appointment reads.
# Absence/false/invalid values deny. Enabling is NOT controller/privacy approval for real data.
FAMILY_DELEGATED_APPOINTMENT_READ_ENABLED=false
# Set true only when local development/test or isolated UAT needs synthetic IDs.
# UAT requires NODE_ENV=production and DEMI_DEPLOYMENT_STAGE=uat; production stage always enforces checksum.
DEMI_ALLOW_TEST_NATIONAL_IDS=false
# Use the same Supabase development project for both database and Auth/API values.
DATABASE_URL=postgresql://postgres:your-development-db-password@db.your-development-project-ref.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:your-development-db-password@db.your-development-project-ref.supabase.co:5432/postgres
IDENTITY_HASH_SECRET=replace-with-a-random-server-secret-at-least-32-characters
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
SUPABASE_PATIENT_EVIDENCE_BUCKET=patient-evidence
# DEMI LINE Login / LIFF configuration. Keep server credentials server-only.
DEMI_LINE_LOGIN_CHANNEL_ID=your-demi-line-login-channel-id
NEXT_PUBLIC_DEMI_LINE_LIFF_ID=your-demi-liff-id
DEMI_LINE_PUBLIC_ORIGIN=https://demi.example.org
# Account LINE Login channel secret ONLY. Used solely to request remote
# deauthorization after an explicit Unlink; missing => local Unlink still succeeds
# and the LINE-side result stays "unconfirmed".
DEMI_LINE_LOGIN_CHANNEL_SECRET=
# LINE MINI App (optional). Leave ALL of the MINI values below empty for an
# Account-only deployment. Setting some but not all, or invalid values, fails
# closed (MINI denied; Account Link/Recovery report a configuration error).
# The MINI endpoint is derived as DEMI_LINE_PUBLIC_ORIGIN + /line/workflow (HTTPS).
# Copy the internal channel's Channel ID and LIFF ID; never infer one from the other.
# Environment: DEVELOPING | REVIEW | PUBLISHED (exact upper-case).
DEMI_LINE_MINI_APP_ENVIRONMENT=
DEMI_LINE_MINI_APP_CHANNEL_ID=
DEMI_LINE_MINI_APP_LIFF_ID=
# MINI channel secret, server-only; used only for remote MINI deauthorization.
DEMI_LINE_MINI_APP_CHANNEL_SECRET=
# Server-only DEMI keyring (never a LINE secret): {"currentKid":"k1","keys":[{"kid":"k1",
# "encryptionKey":"<32 random bytes base64url>","sessionKey":"<32 random bytes base64url>"}]}
DEMI_LINE_MINI_APP_CONTEXT_KEYRING=
# Emergency kill switch: "true" denies all MINI access immediately. Leave empty normally.
DEMI_LINE_MINI_APP_DISABLED=
# DEMI LINE Messaging API channel; do not reuse credentials from another provider.
DEMI_LINE_MESSAGING_CHANNEL_SECRET=your-demi-line-messaging-channel-secret
DEMI_LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=your-demi-line-messaging-channel-access-token
DEMI_LINE_MESSAGING_BOT_USER_ID=U00000000000000000000000000000000
