NODE_ENV=development
DEMI_DATABASE_TARGET=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/demi
DIRECT_URL=postgresql://postgres:password@localhost:5432/demi
IDENTITY_HASH_SECRET=replace-with-a-random-server-secret-at-least-32-characters
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
