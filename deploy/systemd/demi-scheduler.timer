# Every minute; Persistent=true runs one missed tick after downtime (docs/operations/DEPLOY_VPS.md).
# Install: /etc/systemd/system/demi-scheduler.timer, then: sudo systemctl enable --now demi-scheduler.timer

[Unit]
Description=DEMI notification scheduler tick every minute

[Timer]
OnCalendar=*-*-* *:*:00
Persistent=true
AccuracySec=1s
Unit=demi-scheduler.service

[Install]
WantedBy=timers.target
