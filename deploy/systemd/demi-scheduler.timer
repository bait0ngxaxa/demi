# Every 5 minutes; Persistent=true runs one missed tick after downtime (docs/operations/DEPLOY_VPS.md).
# Install: /etc/systemd/system/demi-scheduler.timer, then: sudo systemctl enable --now demi-scheduler.timer

[Unit]
Description=DEMI notification scheduler tick every 5 minutes

[Timer]
OnCalendar=*:0/5
Persistent=true
AccuracySec=10s
Unit=demi-scheduler.service

[Install]
WantedBy=timers.target
