# EXAMPLE ONLY (docs/operations/DEPLOY_VPS.md §1.12). Install as /etc/systemd/system/demi-scheduler-readiness.timer,
# then: sudo systemctl enable --now demi-scheduler-readiness.timer

[Unit]
Description=DEMI notification scheduler readiness check every 5 minutes

[Timer]
OnCalendar=*-*-* *:0/5:30
Persistent=false
AccuracySec=10s
Unit=demi-scheduler-readiness.service

[Install]
WantedBy=timers.target
