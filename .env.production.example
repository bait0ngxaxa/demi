# DEMI production environment for the single VPS (PM2 + nginx) with Supabase Pro.
# Copy to /etc/demi/demi.env (owner root, group demi, mode 0640) and replace EVERY value that
# contains "placeholder" or is an all-zero ID. Never commit the real file.
#
# Check without printing values:
#   npm run env:check -- .env.production.example          (template: placeholders reported, passes)
#   npm run env:check -- --strict /etc/demi/demi.env      (before every deploy: placeholders fail)
#
# Loaded with `node --env-file` by PM2, the scheduler timer, `next build` and `prisma migrate deploy`.
# Quote values that contain spaces, quotes or JSON with single quotes.

# ---------------------------------------------------------------------------
# REQUIRED — runtime core (the readiness probe /api/health checks this group)
# ---------------------------------------------------------------------------
NODE_ENV=production
# Supabase Pro production project (NOT Demi-dev). Session pooler, port 5432. Keep connection_limit >= 2:
# the scheduler tick holds one connection for its lock while its steps use others.
DATABASE_URL=postgresql://postgres.placeholder-project-ref:placeholder-db-password@aws-0-placeholder-region.pooler.supabase.com:5432/postgres?connection_limit=5
# Used by `prisma migrate deploy`. Session pooler (or the direct connection when the VPS has IPv6).
DIRECT_URL=postgresql://postgres.placeholder-project-ref:placeholder-db-password@aws-0-placeholder-region.pooler.supabase.com:5432/postgres
# At least 32 random characters. NEVER rotate without an approved re-hash migration (identity lookups depend on it).
IDENTITY_HASH_SECRET=placeholder-identity-hash-secret-at-least-32-chars
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-supabase-publishable-key
# Server-only. Must differ from the anon/publishable key.
SUPABASE_SERVICE_ROLE_KEY=placeholder-supabase-service-role-key
# Private bucket created in SUPABASE_PRODUCTION.md.
SUPABASE_PATIENT_EVIDENCE_BUCKET=patient-evidence
# At least 32 random bytes; signs reporting pagination cursors.
DEMI_HOSPITAL_REPORTING_CURSOR_SECRET=placeholder-reporting-cursor-secret-32-chars-min
# Canonical public origin <PROD_ORIGIN>: https, origin only, no trailing slash; match every LINE Login, LIFF and webhook endpoint origin exactly.
DEMI_LINE_PUBLIC_ORIGIN=https://prod-origin.placeholder.invalid

# ---------------------------------------------------------------------------
# OPTIONAL — LINE integration configuration; configure each integration only when used
# ---------------------------------------------------------------------------
# Account LINE Login channel and its LIFF app. Pair both values when configuring Account Link/Recovery.
DEMI_LINE_LOGIN_CHANNEL_ID=0000000000
NEXT_PUBLIC_DEMI_LINE_LIFF_ID=0000000000-placeholder
# Messaging API channel of the LINE OA; notifications and webhook features require a complete provider config.
DEMI_LINE_MESSAGING_CHANNEL_SECRET=placeholder-messaging-channel-secret
DEMI_LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=placeholder-messaging-channel-access-token
DEMI_LINE_MESSAGING_BOT_USER_ID=U00000000000000000000000000000000

# ---------------------------------------------------------------------------
# OPTIONAL — validated only when set
# ---------------------------------------------------------------------------
# Strict checksum validation is the default. Exact "true" skips only checksum validation in any NODE_ENV;
# keep it false when processing real patient identities and isolate synthetic data in a separate database.
DEMI_ALLOW_TEST_NATIONAL_IDS=false
# Bearer secret for /api/internal/scheduler/tick and /readiness (systemd timer). 32-1024 characters.
DEMI_SCHEDULER_SECRET=placeholder-scheduler-secret-at-least-32-characters
# Account LINE Login channel secret: only confirms remote deauthorization after Unlink. Recommended.
DEMI_LINE_LOGIN_CHANNEL_SECRET=
# HMAC drain routes. Not used by the VPS timer (it calls the tick); leave empty unless an external worker signs requests.
DEMI_LINE_MEDICATION_REMINDERS_WORKER_SECRET=
DEMI_LINE_APPOINTMENT_NOTIFICATIONS_WORKER_SECRET=
# Vercel Cron only. Leave empty on the VPS.
CRON_SECRET=
# LINE MINI App: all-or-nothing. Leave ALL empty until the MINI channel is configured (LINE_PRODUCTION_SETUP.md).
DEMI_LINE_MINI_APP_ENVIRONMENT=
DEMI_LINE_MINI_APP_CHANNEL_ID=
DEMI_LINE_MINI_APP_LIFF_ID=
DEMI_LINE_MINI_APP_CHANNEL_SECRET=
DEMI_LINE_MINI_APP_CONTEXT_KEYRING=
